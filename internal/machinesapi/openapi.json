{
  "openapi": "3.1.0",
  "info": {
    "title": "TerraScale Orchestrator Machines API",
    "version": "1-alpha",
    "description": "Apps and machines of one region, served by its controllers. The schemas are the shared model of internal/machines (TS-563) and stay unstable until that model settles. Authenticate with a ts-auth access token (RFC 9068 at+jwt) issued to an allowed client; reads need scope orch:read. Members of the terrascale organization see every app; a tenant organization sees only its tenants' apps. See docs/machines-api.md."
  },
  "servers": [{"url": "https://gru.orch.terrascale.tech"}],
  "security": [{"tsAuth": ["orch:read"]}],
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness of this controller's API listener",
        "security": [],
        "responses": {"200": {"description": "Serving", "content": {"application/json": {"schema": {"type": "object", "properties": {"status": {"const": "ok"}}}}}}}
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "This document",
        "security": [],
        "responses": {"200": {"description": "The OpenAPI document"}}
      }
    },
    "/v1/link-health": {
      "get": {
        "summary": "Original minute probe and WAN evidence from every regional controller",
        "operationId": "getLinkHealth",
        "description": "Public read-only health over TLS. No-store; bounded local snapshots share a three-second cache. A 200 reports evidence, not healthy links. Consumers must compare each expected member and admitted peer, reject future evidence, and independently expire probe timestamps older than two minutes. Empty/missing observations are monitoring loss; not_linked and unknown WAN are unobserved, not measured outages. Fetch origins through Atlas; do not derive hostnames from region codes.",
        "security": [],
        "responses": {
          "200": {"description": "Bounded health evidence (at most 128 KiB)", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LinkHealth"}}}},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/apps": {
      "get": {
        "summary": "List the apps the caller may see",
        "operationId": "listApps",
        "responses": {
          "200": {"description": "Apps", "content": {"application/json": {"schema": {"type": "object", "required": ["apps"], "properties": {"apps": {"type": "array", "items": {"$ref": "#/components/schemas/App"}}}}}}},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/apps/{app}": {
      "get": {
        "summary": "Get one app",
        "operationId": "getApp",
        "parameters": [{"$ref": "#/components/parameters/App"}],
        "responses": {
          "200": {"description": "The app", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/App"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/apps/{app}/machines": {
      "get": {
        "summary": "List an app's machines with their observed status",
        "operationId": "listMachines",
        "parameters": [{"$ref": "#/components/parameters/App"}],
        "responses": {
          "200": {"description": "Machines", "content": {"application/json": {"schema": {"type": "object", "required": ["machines"], "properties": {"machines": {"type": "array", "items": {"$ref": "#/components/schemas/Machine"}}}}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/apps/{app}/machines/{id}": {
      "get": {
        "summary": "Get one machine with its observed status",
        "operationId": "getMachine",
        "parameters": [
          {"$ref": "#/components/parameters/App"},
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"}}
        ],
        "responses": {
          "200": {"description": "The machine", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Machine"}}}},
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "503": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "tsAuth": {
        "type": "oauth2",
        "description": "ts-auth access tokens of the issuer https://gru.auth.terrascale.tech/terrascale.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://gru.auth.terrascale.tech/terrascale/oauth/authorize",
            "tokenUrl": "https://gru.auth.terrascale.tech/terrascale/oauth/token",
            "scopes": {"orch:read": "Read apps and machines"}
          }
        }
      }
    },
    "parameters": {
      "App": {"name": "app", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"}}
    },
    "responses": {
      "Error": {"description": "An error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "NotFound": {"description": "No such record, or one the caller may not see", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
    },
    "schemas": {
      "LinkHealth": {
        "type": "object",
        "required": ["version", "region", "observed_at", "expected", "missing", "members"],
        "properties": {
          "version": {"const": 1},
          "region": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time", "description": "Local snapshot gather time, not probe freshness"},
          "expected": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
          "missing": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string"}},
          "members": {"type": "array", "maxItems": 16, "items": {"$ref": "#/components/schemas/LinkHealthMember"}}
        }
      },
      "LinkHealthMember": {
        "type": "object",
        "required": ["member", "observed_at", "links"],
        "properties": {
          "member": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time", "description": "Member snapshot time, not probe freshness"},
          "links": {"type": "array", "maxItems": 32, "items": {"$ref": "#/components/schemas/RegionLinkProbe"}}
        }
      },
      "RegionLinkProbe": {
        "type": "object",
        "required": ["region", "observed_at", "reach", "wan", "rtt_ms"],
        "properties": {
          "region": {"type": "string"},
          "observed_at": {"type": "string", "format": "date-time", "description": "Original minute probe completion time; HTTP polling never advances it"},
          "reach": {"enum": ["ok", "not_linked", "unreachable", "error", "stale"]},
          "wan": {"enum": ["ok", "unknown", "failed", "catching_up"]},
          "lag_groups": {"type": "number", "minimum": 0, "description": "Largest measured directed replication backlog in change groups; absent when unobserved"},
          "rtt_ms": {"type": "number", "minimum": 0}
        }
      },
      "Error": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": {"type": "string", "description": "A stable code: unauthenticated, insufficient_scope, no_organization, invalid_name, not_found, unavailable"},
          "message": {"type": "string"}
        }
      },
      "App": {
        "type": "object",
        "description": "machines.App",
        "required": ["name", "id", "class", "version", "config"],
        "properties": {
          "name": {"type": "string"},
          "id": {"type": "string", "description": "This incarnation of the app"},
          "class": {"enum": ["platform", "tenant"]},
          "tenant": {"type": "string", "description": "The owning tenant of a tenant app"},
          "version": {"type": "integer", "description": "One more on every config change"},
          "config": {"$ref": "#/components/schemas/MachineConfig"},
          "regions": {"type": "object", "additionalProperties": {"type": "integer"}, "description": "Machines per region"},
          "node_pool": {"type": "string"}
        }
      },
      "MachineConfig": {
        "type": "object",
        "description": "machines.MachineConfig: what a host runs",
        "required": ["role", "digest", "resources"],
        "properties": {
          "role": {"type": "string"},
          "digest": {"type": "string"},
          "args": {"type": "array", "items": {"type": "string"}},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "resources": {"type": "object", "properties": {"cpu": {"type": "integer"}, "memory_bytes": {"type": "integer"}, "disk_bytes": {"type": "integer"}}},
          "services": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "port": {"type": "integer"}}}},
          "checks": {"type": "array", "items": {"type": "object"}},
          "restart": {"type": "object", "properties": {"policy": {"enum": ["always", "on-failure", "no"]}, "max_retries": {"type": "integer"}}}
        }
      },
      "Machine": {
        "type": "object",
        "description": "machines.Machine with its machines.Status",
        "required": ["id", "app", "app_id", "region", "version", "config", "desired"],
        "properties": {
          "id": {"type": "string"},
          "app": {"type": "string"},
          "app_id": {"type": "string"},
          "region": {"type": "string"},
          "host": {"type": "string"},
          "failure_domain": {"type": "string"},
          "version": {"type": "integer"},
          "config": {"$ref": "#/components/schemas/MachineConfig"},
          "desired": {"enum": ["started", "stopped", "destroyed"]},
          "status": {
            "type": "object",
            "description": "The last observation of the machine, read apart from its record: it may lag a newer version or desired state; updated_at says when it was observed. Absent until the orchestrator first observes the machine.",
            "properties": {
              "id": {"type": "string"},
              "app": {"type": "string"},
              "state": {"enum": ["pending", "starting", "started", "stopping", "stopped", "failed", "lost", "destroyed"]},
              "updated_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  }
}
