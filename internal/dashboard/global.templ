package dashboard

import (
	"git.terrascale.tech/TerraScale/ts-orchestrator/internal/decisionlog"
	"git.terrascale.tech/TerraScale/ts-orchestrator/internal/insights"
	"git.terrascale.tech/TerraScale/ts-orchestrator/internal/regionview"
)

// globalBody is the landing page: every region side by side, what needs
// attention across them, what happened, and the merged decision timeline.
templ globalBody(current view) {
	<div id="content">
		<div class="page-head">
			<h1>All regions</h1>
			<small class="muted">updated <ts-time datetime={ rfc3339(current.Now) }>{ formatTime(current.Now) }</ts-time> · range { current.State.Range.Key }</small>
		</div>
		@notes(current)
		if current.Journal == nil {
			@journalMissing("The multi-region view")
		}
		if len(current.Summaries) > 0 {
			<p class="lede">{ current.Summaries[0].Text }</p>
		}
		@kpiTiles(current.globalKPIs())
		<div class="cols-2">
			<article>
				<div class="chart-title">
					<h2>Regions <small>health, inter-region links</small></h2>
					<span class="legend">
						<span><span class="dot s-ok"></span>healthy</span>
						<span><span class="dot s-warn"></span>degraded</span>
						<span><span class="dot s-bad"></span>critical</span>
						<span><span class="dot s-idle"></span>unknown / not linked</span>
					</span>
				</div>
				if len(current.Regions) == 0 {
					@unavailable("No region summaries yet.")
				} else {
					<ts-map data-spec={ current.mapJSON() } data-geo={ assetURL("world.json") } role="img" aria-label="World map of regions colored by health"></ts-map>
				}
			</article>
			<article>
				<div class="chart-title">
					<h2>Needs attention</h2>
					<a href={ safe(current.State.link("/insights")) }>All insights →</a>
				</div>
				@insightList(current, current.globalInsights(), 6, true)
			</article>
		</div>
		<h2>Regions side by side</h2>
		<div class="regions">
			for _, summary := range current.Regions {
				@regionCard(current, summary)
			}
		</div>
		<div class="cols-2">
			<article>
				<div class="chart-title">
					<h2>Decision timeline <small>all regions, { current.State.Range.Key }</small></h2>
					<a href={ safe(current.State.link("/decisions")) }>Journal →</a>
				</div>
				@timeline("", current.decisionTimeline(current.decisions(), false))
				@decisionList(current, current.decisions(), 8)
			</article>
			<article class="summary">
				<h2>What happened</h2>
				@summaries(current)
			</article>
		</div>
	</div>
}

templ kpiTiles(tiles []kpi) {
	if len(tiles) > 0 {
		<div class="grid stats">
			for _, tile := range tiles {
				<a class="card-link" href={ safe(tile.Href) }>
					<article class={ "stat", "edge", sClass(tile.Status) }>
						<small>{ tile.Label }</small>
						<strong>{ tile.Value }</strong>
						<span class="sub">{ tile.Sub }</span>
						@sparkline(tile.Spark, "")
					</article>
				</a>
			}
		</div>
	}
}

templ timeline(class string, spec chartSpec) {
	<ts-timeline class={ class } data-spec={ spec.JSON() } role="img" aria-label="Decision timeline"></ts-timeline>
}

// regionCard is one region on the global page.
templ regionCard(current view, summary regionview.Summary) {
	<article class={ "region-card", "edge", sClass(regionStatus(summary.Health.Status)), templ.KV("current", summary.Local) }>
		<header>
			<div>
				<h2><a href={ safe(current.State.link("/region", "r", summary.Region)) }>{ upper(summary.Region) }</a></h2>
				<small class="muted">
					{ regionName(summary.Region) }
					if summary.Local {
						· this region
					}
				</small>
			</div>
			<div class="score">
				<svg width="64" height="64" viewBox="0 0 64 64" role="img" aria-label={ "health score " + itoa(summary.Health.Score) } class={ sClass(regionStatus(summary.Health.Status)) }>
					<circle class="ring-bg" cx="32" cy="32" r="26" fill="none" stroke-width="7"></circle>
					<circle class="ring" cx="32" cy="32" r="26" fill="none" stroke-width="7" stroke-linecap="round" stroke-dasharray={ ringDash(summary.Health.Score) } transform="rotate(-90 32 32)"></circle>
					<text x="32" y="37" text-anchor="middle">{ itoa(summary.Health.Score) }</text>
				</svg>
			</div>
		</header>
		<div>
			@statusPill(regionStatus(summary.Health.Status), string(summary.Health.Status))
			if !summary.Local {
				@statusPill(reachStatus(summary.Reach), reachLabel(summary.Reach))
			}
			if summary.MixedVersions() {
				@statusPill("warn", "mixed versions")
			}
		</div>
		if len(summary.Health.Reasons) > 0 {
			<small class="muted">{ joinWords(summary.Health.Reasons) }</small>
		}
		<dl class="kv">
			<dt>Quorum</dt>
			<dd class={ boolStatus(summary.Quorum.Healthy) }>
				{ itoa(summary.Quorum.Answering) } / { itoa(summary.Quorum.Expected) } answering, { itoa(summary.Quorum.Ready) } ready
				if len(summary.Quorum.Missing) > 0 {
					· missing { joinWords(summary.Quorum.Missing) }
				}
			</dd>
			<dt>Leader</dt>
			<dd>
				{ orDash(summary.Leaders.Authority) }
				if summary.Leaders.Epoch > 0 {
					<small class="muted">epoch { itoa(summary.Leaders.Epoch) }</small>
				}
			</dd>
			<dt>Meta leader</dt>
			<dd>{ orDash(summary.Leaders.MetaLeader) }</dd>
			<dt>Versions</dt>
			<dd title={ versionsText(summary) }>{ versionsText(summary) }</dd>
			<dt>TerraBase</dt>
			<dd>{ itoa(summary.TerraBase.Databases) } databases · { itoa(summary.TerraBase.ServingSeats) }/{ itoa(summary.TerraBase.DesiredSeats) } seats serving</dd>
			<dt>Rollouts</dt>
			<dd>
				if len(summary.Rollouts) == 0 {
					<span class="muted">none active</span>
				} else {
					for _, rollout := range summary.Rollouts {
						<span class="tag">{ short(orDash(rollout.ArtifactDigest), 16) } { percent(rollout.Progress()) }</span>
					}
				}
			</dd>
		</dl>
		<div class="meter">
			<span>CPU</span>
			@ratioBar(summary.Capacity.CPUUtilization)
			<span>Memory</span>
			@ratioBar(capacityRatio(summary.Capacity.MemoryUsedBytes, summary.Capacity.MemoryBytes))
			<span>Disk</span>
			@ratioBar(capacityRatio(summary.Capacity.DiskUsedBytes, summary.Capacity.DiskBytes))
			<span>JetStream</span>
			@ratioBar(storeRatio(summary.Capacity))
		</div>
		<div>
			<h3>Open problems <small>{ itoa(summary.Counts.Total()) }</small></h3>
			if len(summary.Insights) == 0 {
				<small class="muted">Nothing needs attention.</small>
			} else {
				<ul class="mini-list">
					for _, insight := range summary.Insights[:min(3, len(summary.Insights))] {
						<li>
							<span class={ "dot", sClass(severityStatus(insight.Severity)) }></span>
							<a class="grow" href={ safe(current.State.link("/insights", "id", insight.Key)) } title={ insight.Why }>{ insight.Title }</a>
						</li>
					}
				</ul>
			}
		</div>
		<div>
			<h3>Latest decisions</h3>
			if len(summary.Decisions) == 0 {
				<small class="muted">No recent decisions.</small>
			} else {
				<ul class="mini-list">
					for _, decision := range summary.Decisions[:min(3, len(summary.Decisions))] {
						<li>
							<span class={ "dot", sClass(decisionStatus(decision.Status)) }></span>
							<a class="grow" href={ safe(current.State.link("/decisions", "id", decision.ID)) } title={ decision.Reason }>{ decision.Summary }</a>
							<small class="muted">
								@ago(decision.Time)
							</small>
						</li>
					}
				</ul>
			}
		</div>
		<footer>
			<a href={ safe(current.State.link("/region", "r", summary.Region)) }>Open { upper(summary.Region) } →</a>
		</footer>
	</article>
}

// insightList renders ranked insights compactly.
templ insightList(current view, list []insights.Insight, limit int, showRegion bool) {
	if current.Journal == nil || current.Journal.Insights == nil && len(current.Regions) == 0 {
		@unavailable("The insight engine is not running on this member yet.")
	} else if len(list) == 0 {
		<p class="empty">Nothing needs attention. Every rule is quiet.</p>
	} else {
		<ul class="mini-list">
			for _, insight := range list[:min(limit, len(list))] {
				<li>
					@statusPill(severityStatus(insight.Severity), string(insight.Severity))
					if showRegion {
						<span class="tag">{ upper(insight.Region) }</span>
					}
					<a class="grow" href={ safe(current.State.link("/insights", "id", insight.Key)) } title={ insight.Why }>{ insight.Title }</a>
					<small class="muted">
						@ago(insight.FirstSeen)
					</small>
				</li>
			}
		</ul>
		if len(list) > limit {
			<small class="muted">and { itoa(len(list) - limit) } more</small>
		}
	}
}

// decisionList renders decisions newest first, each linking to its chain.
templ decisionList(current view, decisions []decisionlog.Decision, limit int) {
	if current.Journal == nil || current.Journal.Decisions == nil {
		@unavailable("The decision journal is not attached on this member yet.")
	} else if len(decisions) == 0 {
		<p class="empty">No decisions recorded in the last { current.State.Range.Key }.</p>
	} else {
		<ul class="mini-list">
			for _, decision := range decisions[:min(limit, len(decisions))] {
				<li>
					<span class={ "dot", sClass(decisionStatus(decision.Status)) } title={ statusLabel(decision.Status) }></span>
					<span class="tag">{ upper(decision.Region) }</span>
					<a class="grow" href={ safe(current.State.link("/decisions", "id", decision.ID)) } title={ decision.Reason }>{ decision.Summary }</a>
					<small class="muted">
						@ago(decision.Time)
					</small>
				</li>
			}
		</ul>
	}
}

templ summaries(current view) {
	if current.Journal == nil || current.Journal.Summaries == nil {
		@unavailable("Summaries appear once the decision journal and insight engine run.")
	} else if len(current.Summaries) == 0 {
		@unavailable("The summary is unavailable right now.")
	} else {
		for _, summary := range current.Summaries {
			<section>
				<span class="window">Last { insights.WindowPhrase(summary.Window) } · { summary.Scope }</span>
				<p>{ summary.Text }</p>
				<small class="muted">{ itoa(summary.Decisions) } decisions · { itoa(summary.Opened) } insights opened · { itoa(summary.Resolved) } resolved</small>
			</section>
		}
	}
}
