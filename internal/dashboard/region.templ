package dashboard

import "git.terrascale.tech/TerraScale/ts-orchestrator/internal/observability"

// regionBody drills into one region. This member's own region shows its live
// members, charts and events; another region shows the summary it answers
// over the region link plus its journal and insights.
templ regionBody(current view) {
	<div id="content">
		<div class="page-head">
			<h1>
				Region { upper(current.region()) }
				<small class="muted">{ regionName(current.region()) }</small>
			</h1>
			if summary := current.selectedSummary(); summary != nil {
				<span>
					@statusPill(regionStatus(summary.Health.Status), string(summary.Health.Status)+" · score "+itoa(summary.Health.Score))
				</span>
			}
		</div>
		@notes(current)
		if current.remote() {
			<p class="note">Live member detail for { upper(current.region()) } is served by that region's own controllers. This page shows the summary { upper(current.region()) } answers over the region link, its decisions and its insights.</p>
			if summary := current.selectedSummary(); summary != nil {
				<div class="cols-2">
					@regionCard(current, *summary)
					<article>
						<h2>Needs attention in { upper(current.region()) }</h2>
						@insightList(current, current.regionInsights(current.region()), 10, false)
					</article>
				</div>
			} else {
				@unavailable("This region is not configured or has not been summarized yet.")
			}
		} else {
			@kpiTiles(current.regionKPIs())
			<div class="cols-2">
				<article>
					<div class="chart-title">
						<h2>CPU by member</h2>
						<a href={ safe(current.State.link("/members")) }>Hosts →</a>
					</div>
					@chart("", current.lineChart("line", "percent", current.historyRange(observability.HistCPUUtilization, nil, "member", false), "No CPU history yet; the sampler records a point every 10 seconds."))
				</article>
				<article>
					<h2>Needs attention</h2>
					@insightList(current, current.regionInsights(current.region()), 8, false)
				</article>
			</div>
			<div class="cols">
				<article>
					<h2>Members answering</h2>
					@chart("short", current.membersChart())
				</article>
				<article>
					<h2>Readiness checks</h2>
					if len(current.Checks) == 0 {
						@unavailable("No readiness checks are registered yet.")
					} else {
						<ul class="mini-list">
							for _, check := range current.Checks {
								<li>
									@statusPill(boolStatus(check.OK), yesNo(check.OK))
									<span class="grow">{ check.Name }</span>
									<small class="muted">{ check.Detail }</small>
								</li>
							}
						</ul>
					}
				</article>
			</div>
			if errors := current.sectionErrors(); len(errors) > 0 {
				<article>
					<h2>Collection errors</h2>
					<ul>
						for _, entry := range errors {
							<li class="warn">{ entry }</li>
						}
					</ul>
				</article>
			}
		}
		<article>
			<div class="chart-title">
				<h2>Decisions in { upper(current.region()) } <small>by deciding slice</small></h2>
				<a href={ safe(current.State.link("/decisions", "region", current.region())) }>Journal →</a>
			</div>
			@timeline("", current.decisionTimeline(current.decisions(), true))
			@decisionList(current, current.decisions(), 10)
		</article>
		if !current.remote() {
			<article>
				<h2>Recent events</h2>
				@eventTable(current.Events, "overview-events")
				<p><a href={ safe(current.State.link("/events")) }>All events</a></p>
			</article>
		}
	</div>
}
