package dashboard

import (
	"git.terrascale.tech/TerraScale/ts-orchestrator/internal/observability"
	"git.terrascale.tech/TerraScale/ts-orchestrator/internal/regionlink"
	"git.terrascale.tech/TerraScale/ts-orchestrator/internal/regionview"
)

// regionBody drills into one region: this member's own region, with its live
// members, charts and events. Other regions open their global view.
templ regionBody(current view) {
	<div id="content">
		<div class="page-head">
			<h1>
				Region { upper(current.region()) }
				<small class="muted">{ regionName(current.region()) }</small>
			</h1>
			if current.LocalSummary != nil {
				<span>
					@statusPill(regionStatus(current.LocalSummary.Health.Status), string(current.LocalSummary.Health.Status)+" · score "+itoa(current.LocalSummary.Health.Score))
				</span>
			}
			<a href={ safe(current.regionLink(current.localRegion())) }>Global view of this region →</a>
		</div>
		@notes(current)
		if current.LocalSummary != nil {
			@regionLinkProbes(*current.LocalSummary)
		}
		@kpiTiles(current.regionKPIs())
		if current.LocalSummary != nil {
			@regionCard(current, *current.LocalSummary)
		}
		<div class="cols-2">
			<article>
				<div class="chart-title">
					<h2>CPU by member</h2>
					<a href={ safe(current.State.link("/members")) }>Hosts →</a>
				</div>
				@chart("", current.lineChart("line", "percent", current.historyRange(observability.HistCPUUtilization, nil, "member", false), "No CPU history yet; the sampler records a point every 10 seconds."))
			</article>
			<article>
				<h2>Needs attention</h2>
				@insightList(current, current.regionInsights(current.region()), 8, false)
			</article>
		</div>
		<div class="cols">
			<article>
				<h2>Members answering</h2>
				@chart("short", current.membersChart())
			</article>
			<article>
				<h2>Region readiness <small>every member's checks</small></h2>
				if rows := current.readiness(); len(rows) == 0 {
					@unavailable("No readiness checks are registered yet.")
				} else {
					<div class="table-scroll">
						<table class="readiness">
							<thead><tr><th>Member</th><th>Ready</th><th>Checks</th></tr></thead>
							<tbody>
								for _, row := range rows {
									<tr>
										<td>
											{ row.Member }
											if row.Role != "" && row.Role != "controller" {
												<small class="muted">{ row.Role }</small>
											}
										</td>
										<td>
											if row.Missing {
												@statusPill("bad", "not answering")
											} else {
												@statusPill(boolStatus(row.Ready), yesNo(row.Ready))
											}
										</td>
										<td class="wrap">
											for _, check := range row.Checks {
												<span class="check" title={ check.Detail }>
													<span class={ "dot", sClass(boolStatus(check.OK)) }></span>
													{ check.Name }
													if check.Detail != "" {
														<small class="muted">{ check.Detail }</small>
													}
												</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</article>
		</div>
		if errors := current.sectionErrors(); len(errors) > 0 {
			<article>
				<h2>Collection errors</h2>
				<ul>
					for _, entry := range errors {
						<li class="warn">{ entry }</li>
					}
				</ul>
			</article>
		}
		<article>
			<div class="chart-title">
				<h2>Decisions in { upper(current.region()) } <small>by deciding slice</small></h2>
				<a href={ safe(current.State.link("/decisions", "region", current.region())) }>Journal →</a>
			</div>
			@timeline("", current.decisionTimeline(current.decisions(), true))
			@decisionList(current, current.decisions(), 10)
		</article>
		<article>
			<h2>Recent events</h2>
			@eventTable(current.Events, "overview-events")
			<p><a href={ safe(current.State.link("/events")) }>All events</a></p>
		</article>
	</div>
}

templ regionLinkProbes(summary regionview.Summary) {
	<article>
		<h2>Cross-region links <small>tested every minute</small></h2>
		<p class="note">Outgoing probes from { upper(summary.Region) }. WAN lag counts unapplied change groups at the destination's TerraBase receivers.</p>
		if len(summary.Links) == 0 {
			@unavailable("No scheduled link probe has completed yet.")
		} else {
			<div class="table-scroll">
				<table>
					<thead><tr><th>Destination</th><th>Telemetry request</th><th>TerraBase WAN</th><th>Checked</th><th>Recovery</th></tr></thead>
					<tbody>
						for _, probe := range summary.Links {
							<tr>
								<td>{ upper(probe.Region) }</td>
								<td>
									@statusPill(boolStatus(probe.Reach == "ok"), probe.Reach)
									<small class="muted">{ formatFloat(probe.RoundTripMS, 1) } ms</small>
								</td>
								<td>
									@statusPill(boolStatus(probe.WAN == regionlink.WANOK), probe.WAN)
									if probe.Lag != nil {
										<small class="muted">lag { formatFloat(*probe.Lag, 0) } change groups</small>
									}
									if probe.Detail != "" {
										<small class="muted">{ probe.Detail }</small>
									}
								</td>
								<td>{ probe.ObservedAt.UTC().Format("15:04:05 UTC") }</td>
								<td>{ orDash(probe.Recovery) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</article>
}
