package dashboard

// topologyBody is the force graph of regions, controllers, hosts and
// TerraBase seats with NATS routes and leaf connections.
templ topologyBody(current view) {
	<div id="content">
		<div class="page-head">
			<h1>Topology</h1>
			<span class="legend">
				<span><span class="dot s-ok"></span>ready / serving</span>
				<span><span class="dot s-run"></span>converging</span>
				<span><span class="dot s-warn"></span>draining / degraded</span>
				<span><span class="dot s-bad"></span>missing / not ready</span>
				<span><span class="dot s-idle"></span>unknown</span>
			</span>
		</div>
		@notes(current)
		<article class="topology">
			<p class="muted"><small>Each region groups its controllers (inner ring, NATS routes), hosts (outer ring, leaf connections to the meta leader) and TerraBase seats; other regions show what their summary reports. Hover highlights neighbors, click opens details.</small></p>
			<ts-topology data-spec={ current.topologyJSON() } role="img" aria-label="Topology graph of regions, controllers, hosts and seats"></ts-topology>
		</article>
	</div>
}
