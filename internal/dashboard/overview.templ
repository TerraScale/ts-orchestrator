package dashboard

// overviewBody is the landing page. It renders only the in-memory global
// view, so a load or stream tick never asks another region.
templ overviewBody(current view) {
	<div id="content">
		<div class="page-head">
			<h1>All regions</h1>
			<small class="muted">updated <ts-time datetime={ rfc3339(current.Now) }>{ formatTime(current.Now) }</ts-time></small>
		</div>
		@notes(current)
		if current.Journal == nil {
			@journalMissing("The multi-region view")
		} else if len(current.Global) == 0 {
			@unavailable("No region has reported to the global view yet.")
		} else {
			@kpiTiles(overviewTiles(current.Global))
			<article>
				<div class="chart-title">
					<h2>World map <small>health and inter-region links</small></h2>
				</div>
				<ts-map data-spec={ globalMapJSON(current) } data-geo={ assetURL("world.json") } role="img" aria-label="World map of regions colored by health"></ts-map>
			</article>
			<article id="regions">
				<h2>Regions</h2>
				@dataTable(regionTable(current))
			</article>
			<article id="links">
				<h2>Links between regions</h2>
				<p class="muted">Round trip and replication lag from the row region to the column region.</p>
				@dataTable(linkMatrix(current.Global))
			</article>
			<article id="databases">
				<h2>Top databases <small>by replication bandwidth</small></h2>
				@dataTable(databaseTable(topDatabases(current.Global)))
			</article>
			<article id="errors">
				<h2>Recent errors</h2>
				@dataTable(errorTable(recentErrors(current.Global)))
			</article>
		}
	</div>
}
