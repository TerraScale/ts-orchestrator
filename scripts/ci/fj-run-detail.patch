+async fn view_run_detail(repo: &RepoName, api: &Forgejo, run_number: i64) -> eyre::Result<()> {
+    if run_number <= 0 {
+        return Err(eyre!("run number must be positive"));
+    }
+    let runs = api
+        .list_action_runs(
+            repo.owner(),
+            repo.name(),
+            forgejo_api::structs::ListActionRunsQuery {
+                run_number: Some(run_number),
+                ..Default::default()
+            },
+        )
+        .page_size(20)
+        .await?
+        .workflow_runs
+        .unwrap_or_default();
+    let run = runs
+        .into_iter()
+        .find(|run| run.index_in_repo == Some(run_number))
+        .ok_or_eyre("Forgejo run number was not found")?;
+    let run_id = run.id.ok_or_eyre("Forgejo run has no ID")?;
+    let jobs = api
+        .list_action_run_jobs(repo.owner(), repo.name(), run_id)
+        .await?;
+    let detail = serde_json::json!({
+        "run_id": run_id,
+        "run_number": run_number,
+        "head_sha": run.commit_sha.ok_or_eyre("Forgejo run has no commit SHA")?,
+        "workflow": run.workflow_id.ok_or_eyre("Forgejo run has no workflow ID")?,
+        "status": run.status.ok_or_eyre("Forgejo run has no status")?,
+        "jobs": jobs.iter().map(|job| serde_json::json!({
+            "id": job.id,
+            "run_id": job.run_id,
+            "name": job.name,
+            "status": job.status,
+            "attempt": job.attempt,
+        })).collect::<Vec<_>>(),
+    });
+    println!("{}", serde_json::to_string(&detail)?);
+    Ok(())
+}
