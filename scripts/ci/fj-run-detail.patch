index 0000000..8cff150
--- /dev/null
+++ b/src/release/probe.rs
@@ -0,0 +1,496 @@
+//! Bounded, non-persistent diagnosis of a release attachment download.
+
+use std::{
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+use eyre::eyre;
+use forgejo_api::{Forgejo, ForgejoError};
+use futures::{TryStreamExt, io::AsyncReadExt};
+use reqwest::{
+    Client, Url,
+    header::{AUTHORIZATION, HeaderValue},
+    redirect::Policy,
+};
+use serde::Serialize;
+use sha2::{Digest, Sha256};
+
+use crate::{
+    keys::{KeyInfo, LoginInfo},
+    repo::RepoName,
+};
+
+const MAX_BODY_BYTES: usize = 64 * 1024;
+const MAX_REDIRECTS: usize = 5;
+const METADATA_TIMEOUT: Duration = Duration::from_secs(10);
+const DOWNLOAD_TIMEOUT: Duration = Duration::from_secs(20);
+
+#[derive(Default, Serialize)]
+struct RepositoryResult {
+    private: Option<bool>,
+}
+
+#[derive(Default, Serialize)]
+struct ReleaseResult {
+    tag: Option<String>,
+    name: Option<String>,
+    draft: Option<bool>,
+    prerelease: Option<bool>,
+    id: Option<i64>,
+}
+
+#[derive(Serialize)]
+struct AssetResult {
+    name: String,
+    size: Option<i64>,
+    id: Option<i64>,
+}
+
+#[derive(Default, Serialize)]
+struct UrlComparison {
+    origin_equal: Option<bool>,
+    path_equal: Option<bool>,
+    query_equal: Option<bool>,
+}
+
+#[derive(Default, Serialize)]
+struct FetchResult {
+    status: Option<u16>,
+    initial_origin: Option<String>,
+    final_origin: Option<String>,
+    redirect_count: usize,
+    redirect_origins: Vec<String>,
+    body_bytes: Option<u64>,
+    body_sha256: Option<String>,
+    error: Option<&'static str>,
+}
+
+#[derive(Default, Serialize)]
+struct AuthenticatedResult {
+    #[serde(flatten)]
+    fetch: FetchResult,
+    sent_authorization: bool,
+    matches_expected: bool,
+}
+
+#[derive(Serialize)]
+struct AnonymousResult {
+    #[serde(flatten)]
+    fetch: FetchResult,
+    skipped: bool,
+}
+
+impl Default for AnonymousResult {
+    fn default() -> Self {
+        Self {
+            fetch: FetchResult::default(),
+            skipped: true,
+        }
+    }
+}
+
+#[derive(Serialize)]
+struct ProbeResult {
+    schema: &'static str,
+    repository: RepositoryResult,
+    server_version: Option<String>,
+    release: ReleaseResult,
+    asset: AssetResult,
+    url_comparison: UrlComparison,
+    authenticated: AuthenticatedResult,
+    anonymous: AnonymousResult,
+}
+
+impl ProbeResult {
+    fn new(tag: &str, name: &str) -> Self {
+        Self {
+            schema: "terrascale.fj-attachment-probe.v1",
+            repository: RepositoryResult::default(),
+            server_version: None,
+            release: ReleaseResult {
+                tag: Some(tag.to_owned()),
+                ..ReleaseResult::default()
+            },
+            asset: AssetResult {
+                name: name.to_owned(),
+                size: None,
+                id: None,
+            },
+            url_comparison: UrlComparison::default(),
+            authenticated: AuthenticatedResult::default(),
+            anonymous: AnonymousResult::default(),
+        }
+    }
+
+    fn finish(self) -> eyre::Result<()> {
+        // Do not print upstream errors: they can contain the URL query or a token.
+        println!(
+            "{}",
+            serde_json::to_string(&self)
+                .map_err(|_| eyre!("attachment probe serialization failed"))?
+        );
+        if self.authenticated.matches_expected {
+            Ok(())
+        } else {
+            Err(eyre!("attachment probe failed"))
+        }
+    }
+
+    fn fail(mut self, error: &'static str) -> eyre::Result<()> {
+        self.authenticated.fetch.error = Some(error);
+        self.finish()
+    }
+}
+
+async fn metadata<T>(
+    request: impl std::future::IntoFuture<Output = Result<T, ForgejoError>>,
+) -> Result<T, &'static str> {
+    match tokio::time::timeout(
+        METADATA_TIMEOUT,
+        std::future::IntoFuture::into_future(request),
+    )
+    .await
+    {
+        Ok(Ok(value)) => Ok(value),
+        Ok(Err(_)) => Err("metadata_error"),
+        Err(_) => Err("metadata_timeout"),
+    }
+}
+
+fn origin(url: &Url) -> Option<String> {
+    if !matches!(url.scheme(), "http" | "https")
+        || url.host_str().is_none()
+        || !url.username().is_empty()
+        || url.password().is_some()
+    {
+        return None;
+    }
+    Some(url.origin().ascii_serialization())
+}
+
+fn legacy_attachment_url(host: &Url, uuid: &str) -> Option<Url> {
+    let mut url = host.clone();
+    url.set_path("/");
+    url.set_query(None);
+    url.set_fragment(None);
+    url.path_segments_mut()
+        .ok()?
+        .pop_if_empty()
+        .extend(["attachments", uuid]);
+    Some(url)
+}
+
+fn token_for<'a>(keys: &'a mut KeyInfo, host: &Url) -> Option<&'a str> {
+    match keys.get_login(host)? {
+        LoginInfo::Application { token } | LoginInfo::OAuth { token, .. } => Some(token),
+    }
+}
+
+fn request_error(error: &reqwest::Error) -> &'static str {
+    if error.is_timeout() {
+        "timeout"
+    } else if error.is_redirect() {
+        "redirect_error"
+    } else if error.is_connect() {
+        "connection_error"
+    } else if error.is_body() {
+        "body_error"
+    } else {
+        "request_error"
+    }
+}
+
+async fn fetch(
+    url: &Url,
+    token: Option<&str>,
+    remaining_budget: &mut usize,
+) -> (FetchResult, bool) {
+    let mut result = FetchResult {
+        initial_origin: origin(url),
+        ..FetchResult::default()
+    };
+    let redirects = Arc::new(Mutex::new(Vec::new()));
+    let recorded = Arc::clone(&redirects);
+    let policy = Policy::custom(move |attempt| {
+        if attempt.previous().len() > MAX_REDIRECTS {
+            return attempt.error("redirect limit");
+        }
+        let Some(next_origin) = origin(attempt.url()) else {
+            return attempt.error("invalid redirect URL");
+        };
+        match recorded.lock() {
+            Ok(mut origins) => origins.push(next_origin),
+            Err(_) => return attempt.error("redirect state"),
+        }
+        attempt.follow()
+    });
+    let client = match Client::builder()
+        .user_agent(crate::USER_AGENT)
+        .redirect(policy)
+        .connect_timeout(Duration::from_secs(5))
+        .timeout(DOWNLOAD_TIMEOUT)
+        .build()
+    {
+        Ok(client) => client,
+        Err(_) => {
+            result.error = Some("client_error");
+            return (result, false);
+        }
+    };
+    let mut request = client.get(url.clone());
+    if let Some(token) = token {
+        let mut value = match HeaderValue::from_str(&format!("token {token}")) {
+            Ok(value) => value,
+            Err(_) => {
+                result.error = Some("authorization_error");
+                return (result, false);
+            }
+        };
+        value.set_sensitive(true);
+        request = request.header(AUTHORIZATION, value);
+    }
+    let request = match request.build() {
+        Ok(request) => request,
+        Err(_) => {
+            result.error = Some("request_build_error");
+            return (result, false);
+        }
+    };
+    let sent_authorization = request.headers().contains_key(AUTHORIZATION);
+    let response = client.execute(request).await;
+    if let Ok(origins) = redirects.lock() {
+        result.redirect_count = origins.len();
+        result.redirect_origins = origins.clone();
+    } else {
+        result.error = Some("redirect_state");
+        return (result, sent_authorization);
+    }
+    let response = match response {
+        Ok(response) => response,
+        Err(error) => {
+            result.error = Some(request_error(&error));
+            return (result, sent_authorization);
+        }
+    };
+    result.status = Some(response.status().as_u16());
+    result.final_origin = origin(response.url());
+    let status_success = response.status().is_success();
+    if response
+        .content_length()
+        .is_some_and(|len| len > *remaining_budget as u64)
+    {
+        result.error = Some("body_too_large");
+        return (result, sent_authorization);
+    }
+
+    // Read no more than the shared body budget plus one byte, which detects overflow.
+    // Reqwest/hyper may buffer a transport frame internally before this read.
+    let mut reader = Box::pin(
+        response
+            .bytes_stream()
+            .map_err(|error| {
+                let kind = if error.is_timeout() {
+                    std::io::ErrorKind::TimedOut
+                } else {
+                    std::io::ErrorKind::Other
+                };
+                std::io::Error::new(kind, "attachment body read failed")
+            })
+            .into_async_read(),
+    );
+    let mut body = Vec::new();
+    let mut buffer = [0_u8; 8192];
+    loop {
+        let to_read = buffer.len().min(*remaining_budget + 1);
+        match reader.read(&mut buffer[..to_read]).await {
+            Ok(0) => break,
+            Ok(read) if read > *remaining_budget => {
+                *remaining_budget = 0;
+                result.error = Some("body_too_large");
+                return (result, sent_authorization);
+            }
+            Ok(read) => {
+                *remaining_budget -= read;
+                body.extend_from_slice(&buffer[..read]);
+            }
+            Err(error) => {
+                result.error = Some(if error.kind() == std::io::ErrorKind::TimedOut {
+                    "timeout"
+                } else {
+                    "body_error"
+                });
+                return (result, sent_authorization);
+            }
+        }
+    }
+    result.body_bytes = Some(body.len() as u64);
+    result.body_sha256 = Some(format!("{:x}", Sha256::digest(&body)));
+    if !status_success {
+        result.error = Some("http_status");
+    }
+    (result, sent_authorization)
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) async fn run(
+    repo: &RepoName,
+    host: &Url,
+    keys: &mut KeyInfo,
+    tag: &str,
+    name: &str,
+    expected_sha256: &str,
+    expected_bytes: u64,
+    compare_anonymous: bool,
+) -> eyre::Result<()> {
+    let mut result = ProbeResult::new(tag, name);
+    let mut remaining_body_budget = MAX_BODY_BYTES;
+    if expected_sha256.len() != 64 || !expected_sha256.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return result.fail("invalid_expected_sha256");
+    }
+    if expected_bytes > MAX_BODY_BYTES as u64 {
+        return result.fail("expected_bytes_out_of_bounds");
+    }
+    let Some(server_origin) = origin(host) else {
+        return result.fail("invalid_server_url");
+    };
+    let api = match tokio::time::timeout(METADATA_TIMEOUT, keys.get_api(host)).await {
+        Ok(Ok(api)) => api,
+        Ok(Err(_)) => return result.fail("api_client_error"),
+        Err(_) => return result.fail("metadata_timeout"),
+    };
+    let token = token_for(keys, host);
+    let repository = match metadata(api.repo_get(repo.owner(), repo.name())).await {
+        Ok(repository) => repository,
+        Err(error) => return result.fail(error),
+    };
+    result.repository.private = repository.private;
+    let version = match metadata(api.get_version()).await {
+        Ok(version) => version,
+        Err(error) => return result.fail(error),
+    };
+    result.server_version = version.version;
+    let release = match metadata(api.repo_get_release_by_tag(repo.owner(), repo.name(), tag)).await
+    {
+        Ok(release) => release,
+        Err(error) => return result.fail(error),
+    };
+    result.release.tag = release.tag_name.clone();
+    result.release.name = release.name.clone();
+    result.release.draft = release.draft;
+    result.release.prerelease = release.prerelease;
+    result.release.id = release.id;
+    let Some(release_id) = release.id else {
+        return result.fail("release_metadata_incomplete");
+    };
+    let Some(asset_id) = release
+        .assets
+        .as_deref()
+        .unwrap_or_default()
+        .iter()
+        .find(|asset| asset.name.as_deref() == Some(name))
+        .and_then(|asset| asset.id)
+    else {
+        return result.fail("asset_not_found");
+    };
+    let attachment = match metadata(api.repo_get_release_attachment(
+        repo.owner(),
+        repo.name(),
+        release_id,
+        asset_id,
+    ))
+    .await
+    {
+        Ok(attachment) => attachment,
+        Err(error) => return result.fail(error),
+    };
+    result.asset.size = attachment.size;
+    result.asset.id = attachment.id;
+    if attachment.name.as_deref() != Some(name) || attachment.id != Some(asset_id) {
+        return result.fail("asset_metadata_mismatch");
+    }
+    let Some(uuid) = attachment.uuid.as_deref() else {
+        return result.fail("asset_metadata_incomplete");
+    };
+    let Some(legacy_url) = legacy_attachment_url(host, uuid) else {
+        return result.fail("legacy_url_error");
+    };
+    let Some(advertised_url) = attachment.browser_download_url.as_ref() else {
+        return result.fail("advertised_url_missing");
+    };
+    let Some(advertised_origin) = origin(advertised_url) else {
+        return result.fail("invalid_advertised_url");
+    };
+    result.url_comparison.origin_equal =
+        Some(advertised_origin == origin(&legacy_url).unwrap_or_default());
+    result.url_comparison.path_equal = Some(advertised_url.path() == legacy_url.path());
+    result.url_comparison.query_equal = Some(advertised_url.query() == legacy_url.query());
+    result.authenticated.fetch.initial_origin = Some(advertised_origin.clone());
+
+    if advertised_origin != server_origin {
+        // Reqwest strips Authorization on redirects, but cannot protect a
+        // credential attached to an already cross-origin initial URL.
+        result.authenticated.fetch.error = Some("origin_mismatch");
+    } else if let Some(token) = token {
+        (
+            result.authenticated.fetch,
+            result.authenticated.sent_authorization,
+        ) = fetch(advertised_url, Some(token), &mut remaining_body_budget).await;
+        if result.authenticated.fetch.error.is_none() {
+            if result.authenticated.fetch.body_bytes != Some(expected_bytes) {
+                result.authenticated.fetch.error = Some("size_mismatch");
+            } else if !result
+                .authenticated
+                .fetch
+                .body_sha256
+                .as_deref()
+                .is_some_and(|hash| hash.eq_ignore_ascii_case(expected_sha256))
+            {
+                result.authenticated.fetch.error = Some("sha256_mismatch");
+            } else {
+                result.authenticated.matches_expected = true;
+            }
+        }
+    } else {
+        result.authenticated.fetch.error = Some("authorization_unavailable");
+    }
+
+    if compare_anonymous
+        && result.repository.private == Some(false)
+        && result.release.draft == Some(false)
+    {
+        if remaining_body_budget == 0 {
+            result.anonymous.fetch.initial_origin = Some(advertised_origin);
+            result.anonymous.fetch.error = Some("body_budget_exhausted");
+        } else {
+            result.anonymous.skipped = false;
+            result.anonymous.fetch = fetch(advertised_url, None, &mut remaining_body_budget)
+                .await
+                .0;
+        }
+    }
+    result.finish()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{legacy_attachment_url, origin};
+    use url::Url;
+
+    #[test]
+    fn origin_omits_path_and_query_and_rejects_userinfo() {
+        let url = Url::parse("https://example.test:8443/private/path?secret=value").unwrap();
+        assert_eq!(origin(&url).as_deref(), Some("https://example.test:8443"));
+        let with_userinfo = Url::parse("https://user:secret@example.test/path").unwrap();
+        assert_eq!(origin(&with_userinfo), None);
+    }
+
