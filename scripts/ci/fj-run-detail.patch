+async fn view_logs(repo: &RepoName, api: &Forgejo, run_number: i64) -> eyre::Result<()> {
+    if run_number <= 0 {
+        return Err(eyre!("run number must be positive"));
+    }
+    let runs = api
+        .list_action_runs(
+            repo.owner(),
+            repo.name(),
+            forgejo_api::structs::ListActionRunsQuery {
+                run_number: Some(run_number),
+                ..Default::default()
+            },
+        )
+        .page_size(20)
+        .await?
+        .workflow_runs
+        .unwrap_or_default();
+    let run = runs
+        .into_iter()
+        .find(|run| run.index_in_repo == Some(run_number))
+        .ok_or_eyre("Forgejo run number was not found")?;
+    let run_id = run.id.ok_or_eyre("Forgejo run has no ID")?;
+    eprintln!(
+        "run_number={run_number} run_id={run_id} status={:?}",
+        run.status
+    );
+    let jobs = api
+        .list_action_run_jobs(repo.owner(), repo.name(), run_id)
+        .await?;
+    for job in jobs {
+        let job_id = job.id.ok_or_eyre("Forgejo job has no ID")?;
+        eprintln!(
+            "job_id={job_id} name={:?} status={:?} attempt={:?}",
+            job.name, job.status, job.attempt
+        );
+        let logs = api
+            .repo_get_action_job_logs(
+                repo.owner(),
+                repo.name(),
+                job_id,
+                forgejo_api::structs::RepoGetActionJobLogsQuery::default(),
+            )
+            .await?;
+        print!("{logs}");
+    }
+    Ok(())
+}
