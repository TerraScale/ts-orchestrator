{
  "name": "netbird-server",
  "mode": "stateful",
  "priority": "high",
  "image": "docker.io/netbirdio/netbird-server:0.81.3@sha256:9b2f606efefa8ea176e2afbb35c79622ca318e2e605ff1a0f6cb7e158ac08336",
  "regions": [
    "gru"
  ],
  "replicas": 1,
  "minReplicas": 1,
  "maxReplicas": 1,
  "cpuRequestMilli": 500,
  "cpuLimitMilli": 1000,
  "memRequestMiB": 1024,
  "memLimitMiB": 1536,
  "pidsLimit": 1024,
  "port": 8095,
  "readyPath": "/api/instance",
  "readyTimeoutSeconds": 60,
  "hostnames": [
    "netbird.terrascale.tech"
  ],
  "env": {
    "NB_SETUP_PAT_ENABLED": "true",
    "NB_DISABLE_GEOLOCATION": "true"
  },
  "secrets": {},
  "mounts": [
    {
      "source": "/var/lib/ts-data/netbird",
      "target": "/var/lib/netbird"
    }
  ],
  "args": [
    "--config",
    "/var/lib/netbird/config.yaml"
  ],
  "udpPorts": [
    3478,
    51820
  ]
}
