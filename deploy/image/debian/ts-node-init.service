[Unit]
Description=TerraScale node initialization
Wants=network-online.target
After=network-online.target
Before=ts-orch.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=15min
ExecStartPre=/usr/local/sbin/ts-await-data-volume
ExecStart=/usr/local/bin/terrascale-orchestrator node-init

[Install]
WantedBy=multi-user.target
