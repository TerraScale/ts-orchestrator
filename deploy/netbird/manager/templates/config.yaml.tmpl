# NetBird combined server (management + signal + relay + STUN).
# The OpenBao materializer renders this template to /etc/netbird/config.yaml
# (target forgejo-oci-netbird), inserting each secret as a JSON-quoted string.
server:
  listenAddress: ":80"
  exposedAddress: "https://netbird.terrascale.tech:443"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: {{NETBIRD_RELAY_AUTH_SECRET}}
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://netbird.terrascale.tech/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: {{NETBIRD_SESSION_COOKIE_ENCRYPTION_KEY}}
    dashboardRedirectURIs:
      - "https://netbird.terrascale.tech/nb-auth"
      - "https://netbird.terrascale.tech/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    # Host Caddy reaches the loopback publish through the bridge gateway; only
    # it may supply forwarded client addresses (the default trusts everyone).
    trustedHTTPProxies:
      - "10.89.77.1/32"
    trustedPeers:
      - "10.89.77.1/32"

  store:
    engine: "sqlite"
    encryptionKey: {{NETBIRD_DATASTORE_ENCRYPTION_KEY}}
