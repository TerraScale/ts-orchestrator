[Unit]
Description=NetBird dashboard (ts-ops)
After=network-online.target netbird-server.service
Wants=network-online.target netbird-server.service

[Container]
Image=docker.io/netbirdio/dashboard:v2.94.0
ContainerName=netbird-dashboard
Network=netbird.network
PublishPort=127.0.0.1:18080:80
EnvironmentFile=/opt/ts-ops/netbird/dashboard.environment

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=120
CPUWeight=50
MemoryMax=128M
MemorySwapMax=64M

[Install]
WantedBy=multi-user.target
