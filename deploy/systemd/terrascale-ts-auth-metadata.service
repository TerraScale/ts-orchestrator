[Unit]
Description=Reserve OCI instance metadata for host root
DefaultDependencies=no
After=local-fs.target systemd-sysusers.service nftables.service
Wants=network-pre.target
Before=network-pre.target shutdown.target
Before=containerd.service terrascale-orchestrator-managed-host-start.service terrascale-orchestrator-controller-install.service terrascale-orchestrator-bootstrap.service terrascale-orchestrator-managed-runtime.service terrascale-orchestrator-controller.service terrascale-orchestrator-host-setup.service terrascale-orchestrator-host.service
Conflicts=shutdown.target

[Service]
Type=oneshot
# Seed only owned tables; the rules replace both families in one transaction.
ExecStartPre=/bin/sh -c '/usr/sbin/nft list table inet terrascale_metadata >/dev/null 2>&1 || /usr/sbin/nft add table inet terrascale_metadata'
ExecStartPre=/bin/sh -c '/usr/sbin/nft list table bridge terrascale_metadata >/dev/null 2>&1 || /usr/sbin/nft add table bridge terrascale_metadata'
ExecStart=/usr/sbin/nft -f /etc/terrascale-orchestrator/ts-auth-metadata.nft
RemainAfterExit=no
# Returning inactive reapplies rules on every dependent start, not just boot.
# Stopping this unit must not remove the metadata block.

[Install]
RequiredBy=network-pre.target containerd.service terrascale-orchestrator-managed-host-start.service terrascale-orchestrator-controller-install.service terrascale-orchestrator-bootstrap.service terrascale-orchestrator-managed-runtime.service terrascale-orchestrator-controller.service terrascale-orchestrator-host-setup.service terrascale-orchestrator-host.service
