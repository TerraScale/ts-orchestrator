[Unit]
Description=TerraScale orchestrator edge proxy
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
Slice=ts-orch.slice
OOMScoreAdjust=-900
Environment=TS_ORCH_EDGE_HTTPS_REDIRECT=true
ExecStart=/usr/bin/dotnet /opt/ts-orch/current/ts-orch.dll edge
KillSignal=SIGTERM
TimeoutStopSec=55s
Restart=always
RestartSec=1s
RuntimeDirectory=ts-orch
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
