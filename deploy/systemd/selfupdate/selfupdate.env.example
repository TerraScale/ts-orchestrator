# Example /etc/terrascale-orchestrator/selfupdate-<unit>.env, read by the
# opt-in unit drop-in and by terrascale-orchestrator-selfupdate-watchdog@<unit>.
# Root-owned, mode 0644. <unit> is the unit name without ".service".
#
# selfupdate-terrascale-orchestrator-controller.env:
#   TS_SELFUPDATE_PROOF_FILE must equal controller.self_update_proof_file.
#   TS_SELFUPDATE_PROOF_KEY_FILE is controller.response_key_file; only its
#   public half is used to verify the proof.
TS_SELFUPDATE_PROOF_FILE=/var/lib/terrascale-orchestrator-controller/selfupdate-proof.json
TS_SELFUPDATE_PROOF_KEY_FILE=/var/lib/terrascale-orchestrator-secrets/SLOT-response.key
#
# selfupdate-terrascale-orchestrator-host.env:
#   TS_SELFUPDATE_PROOF_FILE must equal host.self_update_proof_file, for
#   example /var/lib/terrascale-orchestrator-host/selfupdate-proof.json.
#   TS_SELFUPDATE_PROOF_KEY_FILE is host.identity_key_file.
