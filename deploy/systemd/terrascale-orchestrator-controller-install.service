[Unit]
Description=Install root-signed TerraScale controller configuration
Wants=network-online.target
After=network-online.target systemd-time-wait-sync.service
Requires=systemd-timesyncd.service systemd-time-wait-sync.service
Before=terrascale-orchestrator-bootstrap.service

[Service]
Type=oneshot
Restart=on-failure
RestartSec=10s
User=root
Group=root
ExecStart=/usr/local/bin/terrascale-orchestrator install-controller-config
TimeoutStartSec=120s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/etc/terrascale-orchestrator
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ProtectProc=invisible
ProcSubset=pid
