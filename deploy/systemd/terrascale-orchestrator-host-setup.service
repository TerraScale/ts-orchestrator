[Unit]
Description=Enroll this TerraScale managed host
Wants=network-online.target systemd-time-wait-sync.service
After=network-online.target systemd-time-wait-sync.service
ConditionPathExists=/etc/terrascale-orchestrator/host-enrollment-public.json
Before=terrascale-orchestrator-host.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/bin/terrascale-orchestrator host-setup --public-config /etc/terrascale-orchestrator/host-enrollment-public.json --output-root /etc/terrascale-orchestrator
ExecStartPost=/usr/bin/systemctl --no-block try-restart terrascale-orchestrator-host.service
Restart=on-failure
RestartSec=10s
TimeoutStartSec=90s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/terrascale-orchestrator
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
