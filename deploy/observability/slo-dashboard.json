{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus backend evaluating the service SLO policy rules",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.4.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "id": null,
  "uid": "terrascale-service-slos",
  "title": "TerraScale service availability SLOs",
  "description": "TS-714 declarative policy assets only. No monitoring runtime is installed; normalized upstream counters require service instrumentation. 30d SLO results remain provisional until 30d observed.",
  "tags": [
    "terrascale",
    "slo",
    "availability"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "terrabase,ts-auth,ts-dashboard",
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {
          "selected": true,
          "text": "terrabase",
          "value": "terrabase"
        },
        "options": [
          {
            "selected": true,
            "text": "terrabase",
            "value": "terrabase"
          },
          {
            "selected": false,
            "text": "ts-auth",
            "value": "ts-auth"
          },
          {
            "selected": false,
            "text": "ts-dashboard",
            "value": "ts-dashboard"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Policy and telemetry prerequisites",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "**Coverage:** TerraBase and auth use existing HTTP duration counts normalized by recording rules; dashboard exports native request outcomes. Deploy and verify all three targets before interpreting availability. Atlas and router are not deployed. HTTP normalization cannot expose every protocol failure hidden behind HTTP 200. Select the Prometheus datasource that evaluates slo-rules.yml.\n\nThe availability objective is **99.9% over a rolling 30 days**, aggregated by request volume across the service fleet. **The 30d SLO is provisional until 30d have been observed.** Missing telemetry and zero traffic are not evidence of health: undefined values display **No data**, never 100%. Remaining budget can be negative. Burn alerts require both paired windows: 1h/5m >14.4, 6h/30m >6, 1d/2h >3, 3d/6h >1. An empty alerts table alone does not establish health."
      }
    },
    {
      "id": 2,
      "title": "Availability objective",
      "type": "stat",
      "description": "Declared policy objective; this is not measured service health.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "slo:objective{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "Availability (30d, provisional)",
      "type": "stat",
      "description": "Request-weighted availability. Provisional until 30d observed; missing or undefined telemetry is No data.",
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "1 - slo:errors:ratio30d{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "title": "Error budget remaining (30d, provisional)",
      "type": "stat",
      "description": "Fraction of the 30d error budget remaining. Negative values show budget exhaustion; no clamp is applied.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No data",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "slo:budget_remaining:ratio30d{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "title": "Eligible requests (30d, provisional)",
      "type": "stat",
      "description": "Observed eligible requests over the available 30d history; provisional until 30d observed.",
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "slo:requests:increase30d{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "title": "Requests per second",
      "type": "timeseries",
      "description": "Fleet request rate over 5 minutes. Missing telemetry leaves gaps; zero traffic does not imply availability success.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "slo:requests:rate5m{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "5m",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "title": "Error budget burn rate",
      "type": "timeseries",
      "description": "Bad-request fraction divided by the policy error-budget fraction. Alert thresholds are 14.4x, 6x, 3x and 1x; both paired windows must exceed the threshold.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:x",
          "noValue": "No data",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ],
          "custom": {
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "slo:burn_rate:ratio5m{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "5m",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B",
          "expr": "slo:burn_rate:ratio30m{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "30m",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "C",
          "expr": "slo:burn_rate:ratio1h{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "1h",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "D",
          "expr": "slo:burn_rate:ratio2h{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "2h",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "E",
          "expr": "slo:burn_rate:ratio6h{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "6h",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "F",
          "expr": "slo:burn_rate:ratio1d{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "1d",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "G",
          "expr": "slo:burn_rate:ratio3d{service=~\"${service:regex}\",slo=\"availability\"}",
          "legendFormat": "3d",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "title": "Active SLO alerts",
      "type": "table",
      "description": "Firing burn-rate and missing-telemetry alerts for the selected service. No rows means no matching firing series; without a functioning monitoring runtime it does not establish health.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "No data",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "ALERTS{service=~\"${service:regex}\",slo=\"availability\",alertname=~\"ServiceSLOBurn.*|ServiceSLOTelemetryMissing\",alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    }
  ]
}
