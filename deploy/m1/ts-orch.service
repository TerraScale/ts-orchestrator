[Unit]
Description=TerraScale Orchestrator single host (milestone 1)
Wants=network-online.target containerd.service
After=network-online.target containerd.service
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=5min
ExecStart=/usr/local/bin/terrascale-orchestrator single-host --state /var/lib/ts-orch
Restart=always
RestartSec=1s
TimeoutStopSec=180s
KillMode=mixed
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=/usr/local/bin
ConfigurationDirectory=systemd/journald.conf.d
ProtectHome=yes
PrivateTmp=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
