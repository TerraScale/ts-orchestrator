func must(t *testing.T, err error) {
	t.Helper()
	if err != nil {
		t.Fatal(err)
	}
}

func certificatePEM(t *testing.T, name string, until time.Time) []byte {
	t.Helper()
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	must(t, err)
	template := &x509.Certificate{SerialNumber: big.NewInt(1), DNSNames: []string{name}, NotBefore: time.Now().Add(-time.Hour), NotAfter: until, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, KeyUsage: x509.KeyUsageDigitalSignature}
	der, err := x509.CreateCertificate(rand.Reader, template, template, key.Public(), key)
	must(t, err)
	private, err := x509.MarshalECPrivateKey(key)
	must(t, err)
	return append(pem.EncodeToMemory(&pem.Block{Type: "EC PRIVATE KEY", Bytes: private}), pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})...)
}

func fleet(t *testing.T) *nats.Conn {
	t.Helper()
	nodes := make([]*server.Server, 3)
	routes := make([]*url.URL, 3)
	ports := make([]int, 3)
	reserved := make([]net.Listener, 3)
	for i := range reserved {
		listener, err := net.Listen("tcp", "127.0.0.1:0")
		must(t, err)
		reserved[i] = listener
		ports[i] = listener.Addr().(*net.TCPAddr).Port
		routes[i], err = url.Parse("nats://" + listener.Addr().String())
		must(t, err)
	}
	for _, listener := range reserved {
		must(t, listener.Close())
	}
	for i := range nodes {
		options := &server.Options{}
		must(t, options.ProcessConfigString(`accounts {
 SYS { users: [{user:sys, password:e2e}] }
 APP { jetstream: enabled, users: [{user:app, password:e2e}] }
}
system_account: SYS`))
		configured := server.Options{ServerName: fmt.Sprintf("edge-e2e-%d", i), Host: "127.0.0.1", Port: -1, JetStream: true, StoreDir: t.TempDir(), NoSigs: true, Routes: routes, Cluster: server.ClusterOpts{Name: "edge-e2e", Host: "127.0.0.1", Port: ports[i]}}
		configured.Accounts, configured.Users, configured.SystemAccount = options.Accounts, options.Users, options.SystemAccount
		s, err := server.NewServer(&configured)
		must(t, err)
		t.Cleanup(func() { s.Shutdown(); s.WaitForShutdown() })
		s.Start()
		if !s.ReadyForConnections(5 * time.Second) {
			t.Fatal("NATS did not start")
		}
		nodes[i] = s
	}
	conn, err := nats.Connect(nodes[0].ClientURL(), nats.UserInfo("app", "e2e"))
	must(t, err)
	t.Cleanup(conn.Close)
	sys, err := nats.Connect(nodes[0].ClientURL(), nats.UserInfo("sys", "e2e"))
	must(t, err)
	defer sys.Close()
	sub, err := sys.SubscribeSync("$SYS.SERVER.*.STATSZ")
	must(t, err)
	defer sub.Unsubscribe()
	must(t, sys.Flush())
	deadline, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	for {
		for _, node := range nodes {
			if len(node.JetStreamClusterPeers()) == 3 {
				return conn
			}
		}
		_, err = sub.NextMsgWithContext(deadline)
		must(t, err)
	}
}

type fakeAuthority struct {
	t         *testing.T
	mu        sync.Mutex
	server    *httptest.Server
	key       *ecdsa.PrivateKey
	root      *x509.Certificate
	orders    map[string]string
	count     map[string]int
	chain     map[string][]byte
	entered   chan struct{}
	proceed   chan struct{}
	challenge func(string) (string, error)
}

func authority(t *testing.T) *fakeAuthority {
	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	must(t, err)
	a := &fakeAuthority{t: t, key: key, root: &x509.Certificate{SerialNumber: big.NewInt(100), Subject: pkix.Name{CommonName: "journey authority"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(365 * 24 * time.Hour), IsCA: true, BasicConstraintsValid: true, KeyUsage: x509.KeyUsageCertSign}, orders: map[string]string{}, count: map[string]int{}, chain: map[string][]byte{}, entered: make(chan struct{}, 1), proceed: make(chan struct{})}
	rootDER, err := x509.CreateCertificate(rand.Reader, a.root, a.root, key.Public(), key)
	must(t, err)
	a.root, err = x509.ParseCertificate(rootDER)
	must(t, err)
	a.server = httptest.NewServer(http.HandlerFunc(a.serve))
	t.Cleanup(a.server.Close)
	return a
}

func (a *fakeAuthority) serve(w http.ResponseWriter, r *http.Request) {
	a.mu.Lock()
	defer a.mu.Unlock()
	base := a.server.URL
	w.Header().Set("Replay-Nonce", base64.RawURLEncoding.EncodeToString([]byte(strconv.FormatInt(time.Now().UnixNano(), 10))))
	w.Header().Set("Content-Type", "application/json")
	var envelope struct {
		Payload string `json:"payload"`
	}
	var payload struct {
		Identifiers        []acme.AuthzID `json:"identifiers"`
		CSR                string         `json:"csr"`
		OnlyReturnExisting bool           `json:"onlyReturnExisting"`
	}
	if r.Method == http.MethodPost {
		if err := json.NewDecoder(r.Body).Decode(&envelope); err != nil {
			http.Error(w, "JWS", 400)
			return
		}
		body, err := base64.RawURLEncoding.DecodeString(envelope.Payload)
		if err != nil {
			http.Error(w, "payload", 400)
			return
		}
		if len(body) > 0 && json.Unmarshal(body, &payload) != nil {
			http.Error(w, "JSON", 400)
			return
		}
	}
	id := r.URL.Query().Get("id")
	switch r.URL.Path {
	case "/directory":
		_ = json.NewEncoder(w).Encode(map[string]string{"newNonce": base + "/nonce", "newAccount": base + "/account", "newOrder": base + "/new-order"})
	case "/nonce":
		w.WriteHeader(http.StatusNoContent)
	case "/account":
		w.Header().Set("Location", base+"/account/1")
		if payload.OnlyReturnExisting {
			w.WriteHeader(http.StatusOK)
		} else {
			w.WriteHeader(http.StatusCreated)
		}
		_, _ = io.WriteString(w, `{"status":"valid"}`)
	case "/new-order":
		if len(payload.Identifiers) != 1 {
			http.Error(w, "identifiers", 400)
			return
		}
		id = payload.Identifiers[0].Value
		a.count[id]++
		a.orders[id] = "pending"
		select {
		case a.entered <- struct{}{}:
		default:
		}
		a.mu.Unlock()
		select {
		case <-a.proceed:
		case <-r.Context().Done():
		}
		a.mu.Lock()
		if r.Context().Err() != nil {
			return
		}
		w.Header().Set("Location", base+"/order?id="+id)
		w.WriteHeader(http.StatusCreated)
		a.writeOrder(w, id)
	case "/order":
		a.writeOrder(w, id)
	case "/authorization":
		_ = json.NewEncoder(w).Encode(map[string]any{"status": map[bool]string{true: "valid", false: "pending"}[a.orders[id] != "pending"], "identifier": acme.AuthzID{Type: "dns", Value: id}, "challenges": []map[string]string{{"type": "http-01", "url": base + "/challenge?id=" + id, "token": id, "status": "pending"}}})
	case "/challenge":
		a.mu.Unlock()
		value, err := a.challenge(id)
		a.mu.Lock()
		if err != nil || value == "" {
			http.Error(w, "challenge unavailable", 400)
			return
		}
		a.orders[id] = "ready"
		_ = json.NewEncoder(w).Encode(map[string]string{"type": "http-01", "url": base + "/challenge?id=" + id, "token": id, "status": "valid"})
	case "/finalize":
		csrDER, err := base64.RawURLEncoding.DecodeString(payload.CSR)
		if err != nil {
			http.Error(w, "CSR", 400)
			return
		}
		csr, err := x509.ParseCertificateRequest(csrDER)
		if err != nil || csr.CheckSignature() != nil {
			http.Error(w, "CSR signature", 400)
			return
		}
		leaf := &x509.Certificate{SerialNumber: big.NewInt(int64(len(a.chain) + 1)), DNSNames: csr.DNSNames, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(90 * 24 * time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
		der, err := x509.CreateCertificate(rand.Reader, leaf, a.root, csr.PublicKey, a.key)
		if err != nil {
			http.Error(w, "sign", 500)
			return
		}
		a.chain[id] = pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der})
		a.orders[id] = "valid"
		a.writeOrder(w, id)
	case "/certificate":
		w.Header().Set("Content-Type", "application/pem-certificate-chain")
		_, _ = w.Write(a.chain[id])
	default:
		http.NotFound(w, r)
	}
}

func (a *fakeAuthority) writeOrder(w http.ResponseWriter, id string) {
	_ = json.NewEncoder(w).Encode(map[string]any{"status": a.orders[id], "identifiers": []acme.AuthzID{{Type: "dns", Value: id}}, "authorizations": []string{a.server.URL + "/authorization?id=" + id}, "finalize": a.server.URL + "/finalize?id=" + id, "certificate": a.server.URL + "/certificate?id=" + id})
}

func TestSharedCertificateJourney(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), 45*time.Second)
	defer cancel()
	meshNode := fleet(t)
	a := authority(t)
	account, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
	must(t, err)
	first := newEdge(t.TempDir(), &acme.Client{Key: account, DirectoryURL: a.server.URL + "/directory"})
	second := newEdge(t.TempDir(), &acme.Client{Key: account, DirectoryURL: a.server.URL + "/directory"})
	name := "shared.e2e.test"
	first.certs.cache.source = func() (*nats.Conn, []byte, error) { return meshNode, bytes.Repeat([]byte{9}, 32), nil }
	second.certs.cache.source = first.certs.cache.source
	for _, node := range []*Edge{first, second} {
		node.SetRoutes(map[string]int{name: 8080}, nil)
		must(t, node.certs.cache.protect())
	}
	plain, _ := second.httpServers()
	probe := httptest.NewServer(plain.Handler)
	defer probe.Close()
	a.challenge = func(token string) (string, error) {
		req, err := http.NewRequestWithContext(ctx, http.MethodGet, probe.URL+challengePath+token, nil)
		if err != nil {
			return "", err
		}
		req.Host = name
		resp, err := http.DefaultClient.Do(req)
		if err != nil {
			return "", err
		}
		defer resp.Body.Close()
		data, err := io.ReadAll(resp.Body)
		if resp.StatusCode != 200 {
			return "", fmt.Errorf("HTTP %d", resp.StatusCode)
		}
		return string(data), err
	}
	issued := make(chan error, 1)
	go func() { issued <- first.certs.ensure(ctx, name) }()
	select {
	case <-a.entered:
	case err := <-issued:
		t.Fatalf("issuer did not reach authority: %v", err)
	case <-ctx.Done():
		t.Fatal(ctx.Err())
	}
	if err := second.certs.ensure(ctx, name); err != errIssueHeld {
		t.Fatalf("concurrent issuer: %v", err)
	}
	close(a.proceed)
	must(t, <-issued)
	for _, node := range []*Edge{first, second} {
		must(t, node.certs.ensure(ctx, name))
	}
	left, err := first.certs.load(ctx, name)
	must(t, err)
	right, err := second.certs.load(ctx, name)
	must(t, err)
	if !bytes.Equal(left.Certificate[0], right.Certificate[0]) {
		t.Fatal("nodes served different certificates")
	}
	a.mu.Lock()
	requests := a.count[name]
	a.mu.Unlock()
	if requests != 1 {
		t.Fatalf("authority requests = %d", requests)
	}
	roots := x509.NewCertPool()
	roots.AddCert(a.root)
	for _, node := range []*Edge{first, second} {
		_, public := node.httpServers()
		endpoint := httptest.NewUnstartedServer(public.Handler)
		endpoint.TLS = public.TLSConfig
		endpoint.StartTLS()
		conn, err := tls.Dial("tcp", endpoint.Listener.Addr().String(), &tls.Config{RootCAs: roots, ServerName: name})
		must(t, err)
		if !bytes.Equal(conn.ConnectionState().PeerCertificates[0].Raw, left.Certificate[0]) {
			t.Fatal("TLS served a different certificate")
		}
		conn.Close()
		endpoint.Close()
	}
	t.Log("two edges complete TLS with one certificate; HTTP-01 on second edge; one authority request")
	js, err := jetstream.New(meshNode)
	must(t, err)
	certs, err := js.KeyValue(ctx, "edge-certs")
	must(t, err)
	encrypted, err := certs.Get(ctx, cacheKey(name))
	must(t, err)
	if bytes.Contains(encrypted.Value(), []byte("PRIVATE KEY")) {
		t.Fatal("private key stored in plaintext")
	}
	wrong := certificateCache{local: first.certs.cache.local, source: func() (*nats.Conn, []byte, error) { return meshNode, bytes.Repeat([]byte{8}, 32), nil }}
	if _, err = wrong.shared(ctx, name); err == nil {
		t.Fatal("wrong encryption key accepted")
	}
	adopted := "adopted.e2e.test"
	original := certificatePEM(t, adopted, time.Now().Add(90*24*time.Hour))
	first.SetRoutes(map[string]int{name: 8080, adopted: 8080}, nil)
	second.SetRoutes(map[string]int{name: 8080, adopted: 8080}, nil)
	must(t, autocert.DirCache(first.certs.cache.local).Put(ctx, adopted, original))
	must(t, first.certs.ensure(ctx, adopted))
	data, err := second.certs.cache.Get(ctx, adopted)
	must(t, err)
	if !bytes.Equal(data, original) {
		t.Fatal("adoption changed certificate")
	}
	restarted := newEdge(t.TempDir(), &acme.Client{Key: account, DirectoryURL: a.server.URL + "/directory"})
	restarted.certs.cache.source = first.certs.cache.source
	restarted.SetRoutes(map[string]int{adopted: 8080}, nil)
	must(t, restarted.certs.ensure(ctx, adopted))
	t.Log("existing certificate adopted unchanged; restarted edge uses shared certificate without CA")
	offline := newEdge(string(first.certs.cache.local)+"-offline", &acme.Client{Key: account, DirectoryURL: a.server.URL + "/directory"})
	offline.SetRoutes(map[string]int{adopted: 8080}, nil)
	must(t, offline.certs.cache.local.Put(ctx, adopted, original))
	_, err = offline.certs.load(ctx, adopted)
	must(t, err)
	a.mu.Lock()
	if a.count[adopted] != 0 {
		t.Fatal("adoption reissued a certificate")
	}
	a.mu.Unlock()
	renewName := "renewed.e2e.test"
	expiring := certificatePEM(t, renewName, time.Now().Add(time.Minute))
	must(t, first.certs.cache.local.Put(ctx, renewName, expiring))
	renewResults := make(chan error, 2)
	for _, node := range []*Edge{first, second} {
		go func() { renewResults <- node.certs.ensure(ctx, renewName) }()
	}
	for range 2 {
		err = <-renewResults
		if err != nil && err != errIssueHeld {
			t.Fatal(err)
		}
	}
	renewed, err := second.certs.cache.Get(ctx, renewName)
	must(t, err)
	if bytes.Equal(expiring, renewed) {
		t.Fatal("renewal retained expiring certificate")
	}
	a.mu.Lock()
	if a.count[renewName] != 1 {
		t.Fatalf("renewal requests = %d", a.count[renewName])
	}
	a.mu.Unlock()
	t.Log("valid local certificate serves before mesh starts; two renewal contenders make one authority request")

	leaseCtx, release, err := first.certs.cache.lease(ctx, "abandoned.e2e.test")
	must(t, err)
	if _, _, err = second.certs.cache.lease(ctx, "abandoned.e2e.test"); err != errIssueHeld {
		t.Fatalf("lease overlap: %v", err)
	}
	deadline, _ := leaseCtx.Deadline()
	if time.Until(deadline) >= issueTTL {
		t.Fatal("issuance can outlive lease")
	}
	release()
	_, release, err = second.certs.cache.lease(ctx, "abandoned.e2e.test")
	must(t, err)
	release()
	t.Log("lease excludes another issuer and transfers after release; issuance deadline precedes expiry")
	leases, err := js.KeyValue(ctx, "edge-cert-leases")
	must(t, err)
	stream, err := js.Stream(ctx, "KV_edge-cert-leases")
	must(t, err)
	config := stream.CachedInfo().Config
	config.MaxAge = time.Second
	config.Duplicates = time.Second
	config.SubjectDeleteMarkerTTL = time.Minute
	_, err = js.UpdateStream(ctx, config)
	must(t, err)
	orphan := "crashed.e2e.test"
	events, err := leases.Watch(ctx, cacheKey(orphan), jetstream.UpdatesOnly())
	must(t, err)
	defer events.Stop()
	_, abandon, err := first.certs.cache.lease(ctx, orphan)
	must(t, err)
	for {
		select {
		case event := <-events.Updates():
			if event != nil && event.Operation() == jetstream.KeyValuePurge {
				goto expired
			}
		case <-ctx.Done():
			t.Fatal(ctx.Err())
		}
	}
expired:
	_, successor, err := second.certs.cache.lease(ctx, orphan)
	must(t, err)
	abandon()
	if _, _, err := first.certs.cache.lease(ctx, orphan); err != errIssueHeld {
		t.Fatalf("stale holder removed successor: %v", err)
	}
	successor()
	t.Log("server expires abandoned lease; successor acquires; stale holder cannot release successor lease")
	ready := atomic.Bool{}
	ready.Store(true)
	backend := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if !ready.Load() {
			w.WriteHeader(503)
		}
	}))
	defer backend.Close()
	_, port, _ := net.SplitHostPort(backend.Listener.Addr().String())
	backendPort, _ := strconv.Atoi(port)
	second.SetReadinessRoutes([]ReadinessRoute{{Host: name, Port: backendPort, Path: "/readyz"}})
	second.listeners.Store(15)
	status := func(want int) {
		t.Helper()
		req := httptest.NewRequest(http.MethodGet, "http://127.0.0.1/edge/ready", nil)
		res := httptest.NewRecorder()
		plain.Handler.ServeHTTP(res, req)
		if res.Code != want {
			t.Fatalf("readiness got %d want %d", res.Code, want)
		}
	}
	status(200)
	second.SetRegionalNodes(func() []mesh.WorkerPeer { return nil })
	releaseDrain, err := second.regional.Load().hold(ctx)
	must(t, err)
	status(503)
	releaseDrain()
	status(200)
	ready.Store(false)
	status(503)
	ready.Store(true)
	second.listeners.Store(7)
	status(503)
	second.listeners.Store(15)
	must(t, second.certs.cache.Delete(ctx, adopted))
	status(503)
	t.Log("readiness: 200 when serving; 503 for drain, failed local readiness, missing listener or certificate")
	info, err := os.Stat(filepath.Join(string(first.certs.cache.local), name))
	must(t, err)
	if info.Mode().Perm() != 0600 {
		t.Fatal("local certificate permissions")
	}
}
