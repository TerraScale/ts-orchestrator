{
  "apiVersion": "terrascale.ci/v3",
  "repository": "TerraScale/TerraScale.Orchestrator",
  "repositoryDependencies": [],
  "nodes": [
    {
      "id": "static",
      "kind": "Static",
      "resourceWeight": "Light",
      "profiles": ["Feature", "Build"],
      "paths": [
        ".editorconfig",
        ".terrascale/",
        "go.mod",
        "go.sum",
        "docs/",
        "cmd/",
        "src/",
        "testdata/",
        "tools/"
      ]
    },
    {
      "id": "build",
      "kind": "Build",
      "resourceWeight": "Medium",
      "profiles": ["Feature", "Build"],
      "paths": [
        ".terrascale/",
        "go.mod",
        "go.sum",
        "cmd/",
        "src/",
        "testdata/",
        "tools/"
      ],
      "dependsOn": ["static"]
    },
    {
      "id": "test",
      "kind": "Test",
      "resourceWeight": "Heavy",
      "profiles": ["Feature", "Build"],
      "paths": [
        "docs/",
        "src/",
        "testdata/",
        "tools/"
      ],
      "dependsOn": ["build"]
    },
    {
      "id": "artifact",
      "kind": "Artifact",
      "resourceWeight": "Heavy",
      "profiles": ["Build"],
      "architectures": ["LinuxX64", "LinuxArm64"],
      "paths": [
        ".terrascale/",
        "go.mod",
        "go.sum",
        "cmd/",
        "src/"
      ],
      "dependsOn": ["test"]
    }
  ]
}
