<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>terrascale-orchestrator</AssemblyName>
    <RootNamespace>TerraScale.Orchestrator</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>linux-arm64;linux-x64</RuntimeIdentifiers>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NATS.Net" />
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="OCI.DotNetSDK.Core" />
    <PackageReference Include="OCI.DotNetSDK.Secrets" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="ZString" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Protocol/protocol-manifest.json"
                      LogicalName="TerraScale.Orchestrator.Protocol.protocol-manifest.json" />
  </ItemGroup>
</Project>
