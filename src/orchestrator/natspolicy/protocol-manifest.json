{
  "name": "terrascale-orchestrator-control-protocol",
  "version": "v1",
  "root": "ts.orch.v1",
  "regionToken": {
    "subjectRule": "strict-lowercase-bijective",
    "payloadRule": "canonical-uppercase-region-code",
    "reservedTokens": ["global"]
  },
  "agentIdentity": {
    "subjectRule": "fixed-sha256-hash-of-admitted-identity",
    "hashTokenShape": "24-lowercase-hex-characters"
  },
  "subjectFamilies": [
    {
      "scope": "global",
      "family": "desired",
      "pattern": "ts.orch.v1.global.desired.>"
    },
    {
      "scope": "global",
      "family": "release",
      "pattern": "ts.orch.v1.global.release.>"
    },
    {
      "scope": "global",
      "family": "query",
      "pattern": "ts.orch.v1.global.query.>"
    },
    {
      "scope": "regional",
      "family": "desired",
      "pattern": "ts.orch.v1.<region>.desired.>"
    },
    {
      "scope": "regional",
      "family": "command",
      "pattern": "ts.orch.v1.<region>.command.>"
    },
    {
      "scope": "regional",
      "family": "observation",
      "pattern": "ts.orch.v1.<region>.observation.>"
    },
    {
      "scope": "regional",
      "family": "operation",
      "pattern": "ts.orch.v1.<region>.operation.>"
    },
    {
      "scope": "regional",
      "family": "query",
      "pattern": "ts.orch.v1.<region>.query.>"
    },
    {
      "scope": "regional",
      "family": "audit",
      "pattern": "ts.orch.v1.<region>.audit.>"
    },
    {
      "scope": "regional",
      "family": "agent",
      "pattern": "ts.orch.v1.<region>.agent.<agent-hash>.>",
      "agentHashToken": true
    }
  ],
  "accountKinds": [
    {
      "kind": "infrastructure-administration",
      "regionScoped": false,
      "platformOnly": true,
      "publish": ["$SYS.>"],
      "subscribe": ["$SYS.>"]
    },
    {
      "kind": "global-authority",
      "regionScoped": false,
      "publish": [
        "ts.orch.v1.global.desired.>",
        "ts.orch.v1.global.release.accepted.>"
      ],
      "subscribe": [
        "ts.orch.v1.global.desired.>",
        "ts.orch.v1.global.release.accepted.>"
      ]
    },
    {
      "kind": "global-directory-read-service",
      "regionScoped": false,
      "readOnly": true,
      "publish": [],
      "subscribe": ["ts.orch.v1.global.query.cells"]
    },
    {
      "kind": "regional-controller",
      "regionScoped": true,
      "publish": [
        "ts.orch.v1.global.query.cells",
        "ts.orch.v1.<region>.desired.>",
        "ts.orch.v1.<region>.command.>",
        "ts.orch.v1.<region>.operation.>",
        "ts.orch.v1.<region>.query.>",
        "ts.orch.v1.<region>.audit.>",
        "ts.orch.v1.<region>.observation.>",
        "ts.orch.v1.<region>.agent.<agent-hash>.command.>"
      ],
      "subscribe": [
        "ts.orch.v1.<region>.desired.>",
        "ts.orch.v1.<region>.command.>",
        "ts.orch.v1.<region>.operation.>",
        "ts.orch.v1.<region>.query.>",
        "ts.orch.v1.<region>.audit.>",
        "ts.orch.v1.<region>.observation.>",
        "ts.orch.v1.<region>.agent.<agent-hash>.observation.>",
        "ts.orch.v1.<region>.agent.<agent-hash>.ack.>"
      ]
    },
    {
      "kind": "host-agent",
      "regionScoped": true,
      "agentHashScoped": true,
      "publish": [
        "ts.orch.v1.<region>.agent.<agent-hash>.observation.>",
        "ts.orch.v1.<region>.agent.<agent-hash>.ack.>"
      ],
      "subscribe": [
        "ts.orch.v1.<region>.agent.<agent-hash>.command.>"
      ]
    },
    {
      "kind": "read-only-monitoring",
      "regionScoped": true,
      "readOnly": true,
      "publish": [],
      "subscribe": [
        "ts.orch.v1.<region>.observation.>",
        "ts.orch.v1.<region>.audit.>"
      ]
    },
    {
      "kind": "break-glass-recovery",
      "regionScoped": false,
      "breakGlass": true,
      "publish": [],
      "subscribe": []
    }
  ]
}
