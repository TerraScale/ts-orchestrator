  "assertion_attribution": [
    {
      "group": "Ordinary management endpoint",
      "test": "TestManagementIntegration",
      "source": "internal/swarmruntime/management_integration_test.go:32",
      "passed": "Real persistent manager admitted through AdmitNode before positive PAUSE. Unix peer, cgroup and binding validation; worker transport negatives; certificate-role, ACTIVE and DRAIN refusals; allowed PAUSE; scoped zero-replica service create/update/remove; resource, placement, stateful negative, CAS, intent generation, release floor, public projection, secret and revocation checks complete. Socket exclusivity and both wrong_UID and wrong_service children pass.",
      "scope": "Fixture has no production worker authority or workload executor. Worker RPC checks verify refusal and redaction, not successful worker admission."
    },
    {
      "group": "Authenticated socket observation",
      "test": "TestManagementObservationIntegration",
      "source": "internal/swarmruntime/management_observation_integration_test.go:25",
      "passed": "Wrong accepted identity refused. Broad Watch offers no access under the explicit PermissionDenied-or-Unimplemented contract. Private secret and foreign config exclusion, scoped snapshot and quiet-through, actual config create/update/remove handoff, bounded WAL replay despite equal endpoint snapshots, live old-object preservation, replay old-object absence, quiet resume, persistent manager restart lifetime change and revoked-stream refusal complete.",
      "scope": "Broad Watch refusal does not prove a registered broad Watch interceptor path. Single manager restart qualifies this scenario; no HA failover is tested."
    },
    {
      "group": "Privileged local owner observation",
      "test": "TestLocalManagementObservationIntegration",
      "source": "internal/swarmruntime/management_observation_local_test.go:15",
      "passed": "Nil and unadmitted managers and empty environment refuse. Real AdmitNode establishes current identity. Scoped snapshot excludes secret and foreign config. Quiet-through, live create/remove and exact replay despite equal endpoint snapshots pass. Original instance drift invalidates an existing stream and a new constructor. After identity restoration, stopped manager invalidates the buffered or stalled source and new Observe calls; source goroutine completion is asserted.",
      "scope": "Node-owned observer serves a privileged in-process owner separately from Unix authentication. This root does not wire or qualify APP, OBS or DATA consumers."
    },
    {
      "group": "Send and storage boundaries",
      "tests": [
        "TestManagementObservationBlockedSend",
        "TestManagementObservationGRPCBlockedSend",
        "TestManagementObservationStoreBoundaries",
        "TestManagementObservationSlowConsumer"
      ],
      "passed": "Three manual blocked-send leaves cover overflow, caller cancellation and authority revocation. Actual gRPC fixture primes a first 1 MiB write, holds the second write for 50 ms under a fixed 64 KiB client stream window, then verifies OutOfRange handler return and actual SendMsg completion. MemoryStore applied watermark, ordinary and batch changes, replay, compaction, future resume, restore and follower boundaries pass. Bounded watch overflow over 4,096 values passes.",
      "scope": "Corrected gRPC backpressure precondition is exercised. Memory proposer tests provide store unit coverage; the separate nested Raft root is not executed."
    },
    {
      "group": "Effect bracket and PID contexts",
      "tests": [
        "TestManagementStatefulEffectBracket",
        "TestManagementPeerPIDAdmission"
      ],
      "passed": "Root plus seven effect leaves enforce one synchronous effect and missing, duplicate, nil, canceled, effect-error and post-effect-veto semantics, with foreign-scope refusal. Root plus four peer leaves validate private admission context and kernel PID extraction.",
      "scope": "Direct test identity objects supplement the actual Unix peer root. This is not production security certification."
    }
  ],
