+package cli
+
+import (
+	"crypto/ecdh"
+	"crypto/ed25519"
+	"crypto/rand"
+	"crypto/sha256"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/pem"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/TerraScale/ts-orchestrator/internal/managedmaterial"
+	"github.com/TerraScale/ts-orchestrator/internal/protocol"
+)
+
+func TestCustomerEnvelopeFilesystemBoundary(t *testing.T) {
+	_, _, controllerPath, recipientPath, baseSpec, baseReply, keys := customerOpenFixture(t)
+	secondCatalog, err := managedmaterial.InitialCatalog("1G000000000000000000000002", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	baseSpec.Catalogs = append(baseSpec.Catalogs, managedmaterial.InitialCatalogInput{
+		CollectionID: secondCatalog.CollectionID, CanonicalCatalog: secondCatalog.Bytes,
+	})
+	baseSpec.Recipient.Signature = ed25519.Sign(keys.recipientSigner, managedmaterial.RecipientGrantMessage(baseSpec))
+	now := time.Now().UTC()
+	bundle, err := managedmaterial.GenerateInitial(baseSpec, keys.recipientSigner.Public().(ed25519.PublicKey), now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(baseSpec.Catalogs) != 2 || len(bundle.Members) != 2 {
+		t.Fatal("customer envelope fixture must preserve two catalogs and two members")
+	}
+	digestJSON := func(t *testing.T, value any) string {
+		t.Helper()
+		wire, err := protocol.EncodeJSON(value)
+		if err != nil {
+			t.Fatal(err)
+		}
+		digest := sha256.Sum256(wire)
+		return hex.EncodeToString(digest[:])
+	}
+	object := baseReply.Receipt.Object
+	object.SpecSHA256 = digestJSON(t, baseSpec)
+	object.Name = "material/v2/gru/" + baseSpec.PlacementDatabaseID + "/" + baseSpec.PartitionID + "/g1-" + object.SpecSHA256 + ".json"
+	baseReply.Receipt, err = managedmaterial.SignPreparationReceipt("gru", baseSpec.PartitionID,
+		baseSpec, bundle, object, keys.controller, now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	baseReply.Customer = bundle.Customer
+
+	for _, test := range []struct {
+		name      string
+		wantError string
+	}{
+		{name: "Success"},
+		{name: "WrongRecipient", wantError: "customer envelope recipient or fields are invalid"},
+		{name: "FlippedCiphertext", wantError: "customer envelope authentication failed"},
+		{name: "AlternatePartition", wantError: "customer envelope authentication failed"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			directory := t.TempDir()
+			spec, reply, keyPath := baseSpec, baseReply, recipientPath
+			switch test.name {
+			case "WrongRecipient":
+				wrong, err := ecdh.X25519().GenerateKey(rand.Reader)
+				if err != nil {
+					t.Fatal(err)
+				}
+				privateDER, err := x509.MarshalPKCS8PrivateKey(wrong)
+				if err != nil {
+					t.Fatal(err)
+				}
+				keyPath = filepath.Join(directory, "wrong-recipient.pem")
+				if err := os.WriteFile(keyPath,
+					pem.EncodeToMemory(&pem.Block{Type: "PRIVATE KEY", Bytes: privateDER}), 0o600); err != nil {
+					t.Fatal(err)
+				}
+				if parsed, err := managedmaterial.ReadRecipientKey(keyPath); err != nil || !parsed.Equal(wrong) {
+					t.Fatalf("wrong-recipient fixture is not a readable X25519 key: %v", err)
+				}
+			case "FlippedCiphertext":
+				first := "A"
+				if strings.HasPrefix(reply.Customer.Ciphertext, first) {
+					first = "B"
+				}
+				reply.Customer.Ciphertext = first + reply.Customer.Ciphertext[1:]
+				reply.Receipt.CustomerEnvelopeSHA256 = digestJSON(t, reply.Customer)
+			case "AlternatePartition":
+				spec.PartitionID = "00000000001WFHC56Q8NB0X6T8"
+				reply.Receipt.Spec = spec
+				reply.Receipt.PartitionID = spec.PartitionID
+				reply.Receipt.SpecSHA256 = digestJSON(t, spec)
+				reply.Receipt.Object.SpecSHA256 = reply.Receipt.SpecSHA256
+				reply.Receipt.Object.Name = "material/v2/gru/" + spec.PlacementDatabaseID + "/" + spec.PartitionID + "/g1-" + reply.Receipt.SpecSHA256 + ".json"
+			}
+			if test.name == "FlippedCiphertext" || test.name == "AlternatePartition" {
+				// Re-sign the outer pins so rejection must reach inner envelope authentication.
+				reply.Receipt.Signature = ""
+				unsigned, err := protocol.EncodeJSON(reply.Receipt)
+				if err != nil {
+					t.Fatal(err)
+				}
+				reply.Receipt.Signature = base64.RawURLEncoding.EncodeToString(ed25519.Sign(keys.controller,
+					append([]byte("TS-MANAGED-MATERIAL-PREPARATION-V2\x00"), unsigned...)))
+			}
+			if err := managedmaterial.VerifyPreparationReply(reply.Receipt, reply.Customer,
+				keys.controller.Public().(ed25519.PublicKey), "gru", spec.PartitionID, spec); err != nil {
+				t.Fatalf("outer receipt must verify before opening the envelope: %v", err)
+			}
+
+			specPath := filepath.Join(directory, "spec.json")
+			replyPath := filepath.Join(directory, "reply.json")
+			for _, file := range []struct {
+				path  string
+				value any
+			}{
+				{specPath, spec}, {replyPath, reply},
+			} {
+				wire, err := protocol.EncodeJSON(file.value)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(file.path, wire, 0o644); err != nil {
+					t.Fatal(err)
+				}
+			}
+			output := filepath.Join(directory, "customer.json")
+			err := Run(t.Context(), customerOpenArgs(specPath, replyPath, controllerPath, keyPath, output), io.Discard)
+			if test.wantError != "" {
+				if err == nil || err.Error() != test.wantError {
+					t.Fatalf("envelope rejection = %v, want %q", err, test.wantError)
+				}
+				if _, err := os.Lstat(output); !os.IsNotExist(err) {
+					t.Fatalf("rejected envelope published customer material: %v", err)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			wire, err := os.ReadFile(output)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var material managedmaterial.CustomerMaterial
+			if err := protocol.DecodeStrict(wire, &material, 16<<10); err != nil ||
+				material.Version != 1 || !strings.HasPrefix(material.Token, "tbk1.") ||
+				!strings.Contains(material.HTTPSCAPEM, "BEGIN CERTIFICATE") {
+				t.Fatalf("filesystem output differs from prepared customer material: %v", err)
+			}
+			if info, err := os.Stat(output); err != nil || info.Mode().Perm() != 0o600 {
+				t.Fatalf("customer output is not owner-only: %v", err)
+			}
+		})
+	}
+}
