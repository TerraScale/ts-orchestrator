      "end_line": 440,
      "exact_source": "func TestFunctionWorkerRejectsExpiredMaterial(t *testing.T) {\n\tproof, deployment, files := signedFunctionFixture(t, integrationArtifact(t, \"echo\"))\n\tdeployment.BrokerURL = \"tls://127.0.0.1:4222\"\n\tfor name, expiry := range map[string]time.Time{\"missing\": {}, \"expired\": time.Now().Add(-time.Second), \"beyond release\": proof.ExpiresAt().Add(time.Second)} {\n\t\tt.Run(name, func(t *testing.T) {\n\t\t\tdeployment.ExpiresAt = expiry\n\t\t\twire, err := json.Marshal(deployment)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tdirectory := t.TempDir()\n\t\t\tfor name, value := range files {\n\t\t\t\tif err := os.WriteFile(filepath.Join(directory, name), value, 0600); err != nil {\n\t\t\t\t\tt.Fatal(err)\n\t\t\t\t}\n\t\t\t}\n\t\t\tif err := os.WriteFile(filepath.Join(directory, \"deployment.json\"), wire, 0600); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tif err := runProcess(t.Context(), directory, \"127.0.0.1:0\", io.Discard); err == nil || !strings.Contains(err.Error(), \"material authority\") {\n\t\t\t\tt.Fatalf(\"invalid material expiry accepted: %v\", err)\n\t\t\t}\n\t\t})\n\t}\n}",
      "sha256": "d84525af69df88578d8dd3940c828fe68d2b3cea97ab9a18e4ff163af8cb5db3"
    },
    {
      "commit": "d4ac68882716e7cfb14afca2f88ad596a38041af",
      "path": "internal/functions/process.go",
      "start_line": 51,
      "end_line": 117,
      "exact_source": "func runProcess(ctx context.Context, directory, address string, output io.Writer) error {\n\troot, err := os.OpenRoot(directory)\n\tif err != nil {\n\t\treturn fmt.Errorf(\"function material directory: %w\", err)\n\t}\n\tdefer root.Close()\n\tread := func(name string, limit int64, secret bool) ([]byte, error) {\n\t\tfile, err := root.Open(name)\n\t\tif err != nil {\n\t\t\treturn nil, fmt.Errorf(\"read function material %s: %w\", name, err)\n\t\t}\n\t\tdefer file.Close()\n\t\tinfo, err := file.Stat()\n\t\tif err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tif !info.Mode().IsRegular() || info.Size() > limit || (secret && info.Mode().Perm()&0077 != 0) {\n\t\t\treturn nil, fmt.Errorf(\"invalid function material %s size or permissions\", name)\n\t\t}\n\t\tvalue, err := io.ReadAll(io.LimitReader(file, limit+1))\n\t\tif err != nil || int64(len(value)) > limit {\n\t\t\treturn nil, fmt.Errorf(\"read function material %s exceeded bound\", name)\n\t\t}\n\t\treturn value, nil\n\t}\n\tdeploymentWire, err := read(\"deployment.json\", 16<<10, false)\n\tif err != nil {\n\t\treturn err\n\t}\n\tvar deployment ProcessDeployment\n\tif err := json.Unmarshal(deploymentWire, &deployment, json.RejectUnknownMembers(true)); err != nil {\n\t\treturn fmt.Errorf(\"function deployment: %w\", err)\n\t}\n\tbrokerURL, err := url.Parse(deployment.BrokerURL)\n\tif err != nil || brokerURL.Scheme != \"tls\" || brokerURL.Host == \"\" || brokerURL.User != nil || brokerURL.Path != \"\" || brokerURL.RawQuery != \"\" || brokerURL.Fragment != \"\" {\n\t\treturn errors.New(\"function broker requires one verified TLS endpoint\")\n\t}\n\trootPublic, err := read(\"root.pub\", ed25519.PublicKeySize, false)\n\tif err != nil {\n\t\treturn err\n\t}\n\troots, err := trust.ParseKeyring(ed25519.PublicKey(rootPublic))\n\tif err != nil {\n\t\treturn err\n\t}\n\treceipt, err := read(\"receipt.json\", 64<<10, false)\n\tif err != nil {\n\t\treturn err\n\t}\n\tdelegation, err := read(\"delegation.json\", 64<<10, false)\n\tif err != nil {\n\t\treturn err\n\t}\n\tmodule, err := read(\"module.wasm\", MaxModuleBytes, false)\n\tif err != nil {\n\t\treturn err\n\t}\n\tproof, err := release.VerifyFunctionCurrent(receipt, delegation, module, roots, release.FunctionExpectation{\n\t\tEnvironment: deployment.Environment, Cell: deployment.Cell, TenantID: deployment.TenantID,\n\t\tFunctionID: deployment.FunctionID, Revision: deployment.Revision, Digest: deployment.Digest, MinimumSequence: deployment.MinimumSequence,\n\t}, time.Now())\n\tif err != nil {\n\t\treturn fmt.Errorf(\"admit function worker: %w\", err)\n\t}\n\tif !deployment.ExpiresAt.After(time.Now()) || deployment.ExpiresAt.After(proof.ExpiresAt()) {\n\t\treturn errors.New(\"function material authority expired or exceeds signed release\")\n\t}",
      "sha256": "24fbb84ab725ab4e917d2cd795acfbbe948ad40065372c7f5e61c817e9fdc3f1"
