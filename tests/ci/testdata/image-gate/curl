#!/usr/bin/env bash
# Isolated GitHub CLI transport fixture; never contacts a server.
set -euo pipefail
[[ $1 == api && $GH_HOST == github.com && $GH_TOKEN == fixture-token ]] || exit 2
if [[ $* == *'dispatches'* ]]; then
	[[ $2 == --method && $3 == POST ]] || exit 2
	printf '%s' "$4" > "$MOCK_ROOT/url"
	shift 4
	payload='{"inputs":{}}'
	while (($#)); do
		[[ $1 == -f ]] || exit 2
		key=${2%%=*}
		value=${2#*=}
		if [[ $key == ref ]]; then
			payload=$(jq -cn --argjson payload "$payload" --arg value "$value" '$payload + {ref:$value}')
		elif [[ $key == inputs\[*\] ]]; then
			key=${key#inputs[}
			key=${key%]}
			payload=$(jq -cn --argjson payload "$payload" --arg key "$key" --arg value "$value" '$payload | .inputs[$key] = $value')
		else
			exit 2
		fi
		shift 2
	done
	printf '%s' "$payload" > "$MOCK_ROOT/payload"
	exit 0
fi
# The dispatch test has no release to compare against.
if [[ $* == *'/releases?'* ]]; then printf '[]'; exit 0; fi
printf '%s\n' "$*" >> "$MOCK_ROOT/requests"
count=0
if [[ -r $MOCK_ROOT/count ]]; then read -r count < "$MOCK_ROOT/count"; fi
((count += 1))
printf '%s\n' "$count" > "$MOCK_ROOT/count"
case $MOCK_MODE:$count in
	transient:1|persistent:*|supersession-transient:2) exit 22 ;;
	null:1) printf 'null'; exit 0 ;;
	malformed:1) printf '{'; exit 0 ;;
esac
if [[ $* == *'status=success'* ]]; then
	[[ $* == *'--paginate --slurp'* ]] || exit 2
	latest=$MOCK_SOURCE
	id=42
	if [[ $MOCK_MODE == newer ]]; then latest=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb; id=100; fi
	jq -cn --arg source "$latest" --argjson id "$id" \
		'[{workflow_runs:[{id:$id,run_number:7,path:".github/workflows/ci.yml",head_branch:"main",head_sha:$source,status:"completed",conclusion:"success"}]}]'
else
	[[ $* == *'/actions/runs/42'* ]] || exit 2
	id=42
	if [[ $MOCK_MODE == wrong-id ]]; then id=41; fi
	jq -cn --arg source "$MOCK_SOURCE" --arg conclusion "$MOCK_STATUS" --argjson id "$id" \
		'{id:$id,run_number:7,path:".github/workflows/ci.yml",head_branch:"main",head_sha:$source,status:"completed",conclusion:$conclusion}'
fi
