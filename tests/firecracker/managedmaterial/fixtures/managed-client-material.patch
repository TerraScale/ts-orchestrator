+#[cfg(unix)]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn signed_v2_managed_material_pins_close_reload_and_original_pins_recover() {
+    if rustix::process::geteuid().as_raw() != 0 {
+        return; // The exact root-owned file contract is exercised in the root VM fast suite.
+    }
+    let fixture = Fixture::new();
+    let material = ManagedMaterialFixture::new(&fixture);
+    let mut server = fixture.spawn_managed(&material, &material.manifest_sha256);
+    fixture.wait_ready(&mut server).await;
+    fixture
+        .commit_on(&fixture.https_client(), fixture.client_port, DOCUMENT, 0x91)
+        .await;
+
+    for path in [
+        &material.registry,
+        &material.certificate,
+        &material.key,
+        &material.config,
+    ] {
+        let original = fs::read(path).expect("read original managed material");
+        let mut valid_but_unpinned = original.clone();
+        valid_but_unpinned.push(b'\n');
+        fs::write(path, valid_but_unpinned).expect("replace valid material bytes");
+        // Even a coherent replacement manifest cannot alter frozen startup pins.
+        material.write_manifest();
+        server.signal_hup();
+        fixture.wait_unready(&mut server).await;
+        assert!(
+            server
+                .stderr()
+                .contains("client reload rejected; admissions closed")
+        );
+        fs::write(path, original).expect("restore pinned material");
+        server.signal_hup();
+        fixture.wait_ready(&mut server).await;
+    }
+    assert!(server.terminate().success(), "{}", server.stderr());
+}
