+#[cfg(unix)]
+async fn wait_managed_startup_failure(server: &mut RunningServer) {
+    let deadline = Instant::now() + STARTUP_TIMEOUT;
+    loop {
+        if let Some(status) = server.child.try_wait().expect("poll managed process") {
+            assert!(!status.success(), "unsafe managed material was accepted");
+            assert!(!server.ready().await, "unsafe material exposed readiness");
+            return;
+        }
+        assert!(
+            Instant::now() < deadline,
+            "managed startup did not fail: {}",
+            server.stderr()
+        );
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    }
+}
