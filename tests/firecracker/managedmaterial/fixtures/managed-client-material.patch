+//! Narrow root-provisioned file policy for signed-v2 HTTPS client material.
+//! The independent manifest digest is supplied by the signed process plan.
+
+use std::fs::{self, OpenOptions};
+use std::io::{self, Read};
+use std::path::{Component, Path, PathBuf};
+
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use zeroize::Zeroize;
+
+use crate::config::{ClientConfig, parse_client_config};
+
+const MAX_MANIFEST_BYTES: usize = 4 * 1024;
+const MAX_CONFIG_BYTES: usize = 16 * 1024;
+pub(crate) const MAX_TLS_BYTES: usize = 2 * 1024 * 1024;
+pub(crate) const MAX_REGISTRY_BYTES: usize = 256 * 1024;
+
+#[derive(Clone, Debug)]
+pub struct ManagedClientMaterial {
+    config_path: PathBuf,
+    config_sha256: [u8; 32],
+    certificate_chain_sha256: [u8; 32],
+    private_key_sha256: [u8; 32],
+    api_key_registry_sha256: [u8; 32],
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Manifest {
+    version: u64,
+    client_config_sha256: String,
+    certificate_chain_sha256: String,
+    private_key_sha256: String,
+    api_key_registry_sha256: String,
+}
+
+impl ManagedClientMaterial {
+    /// Verify the independently signed manifest hash before accepting its pins.
+    /// Pins remain fixed for this process, including every SIGHUP reload.
+    pub fn open(
+        manifest_path: &Path,
+        manifest_sha256: &str,
+        config_path: &Path,
+    ) -> io::Result<Self> {
+        let expected = lower_sha256(manifest_sha256)?;
+        let bytes = read_pinned(manifest_path, MAX_MANIFEST_BYTES, expected, false)?;
+        let manifest: Manifest = serde_json::from_slice(&bytes).map_err(|_| invalid_material())?;
+        if manifest.version != 1 {
+            return Err(invalid_material());
+        }
+        Ok(Self {
+            config_path: config_path.to_owned(),
+            config_sha256: lower_sha256(&manifest.client_config_sha256)?,
+            certificate_chain_sha256: lower_sha256(&manifest.certificate_chain_sha256)?,
+            private_key_sha256: lower_sha256(&manifest.private_key_sha256)?,
+            api_key_registry_sha256: lower_sha256(&manifest.api_key_registry_sha256)?,
+        })
+    }
+
+    pub(crate) fn load_client_config(&self) -> io::Result<ClientConfig> {
+        let bytes = read_pinned(
+            &self.config_path,
+            MAX_CONFIG_BYTES,
+            self.config_sha256,
+            false,
+        )?;
+        parse_client_config(&bytes).map_err(|_| invalid_material())
+    }
+
+    pub(crate) fn read_certificate(&self, path: &Path) -> io::Result<Vec<u8>> {
+        read_pinned(path, MAX_TLS_BYTES, self.certificate_chain_sha256, false)
+    }
+
+    pub(crate) fn read_private_key(&self, path: &Path) -> io::Result<Vec<u8>> {
+        read_pinned(path, MAX_TLS_BYTES, self.private_key_sha256, true)
+    }
+
+    pub(crate) fn read_registry(&self, path: &Path) -> io::Result<Vec<u8>> {
+        read_pinned(path, MAX_REGISTRY_BYTES, self.api_key_registry_sha256, true)
+    }
+}
+
+fn lower_sha256(value: &str) -> io::Result<[u8; 32]> {
+    if value.len() != 64 {
+        return Err(invalid_material());
+    }
+    let mut digest = [0_u8; 32];
+    for (index, pair) in value.as_bytes().chunks_exact(2).enumerate() {
+        let hi = lower_hex(pair[0]).ok_or_else(invalid_material)?;
+        let lo = lower_hex(pair[1]).ok_or_else(invalid_material)?;
+        digest[index] = (hi << 4) | lo;
+    }
+    Ok(digest)
+}
+
+fn lower_hex(byte: u8) -> Option<u8> {
+    match byte {
+        b'0'..=b'9' => Some(byte - b'0'),
+        b'a'..=b'f' => Some(byte - b'a' + 10),
+        _ => None,
+    }
+}
+
+fn invalid_material() -> io::Error {
+    io::Error::new(
+        io::ErrorKind::InvalidData,
+        "managed client material is invalid",
+    )
+}
+
+#[cfg(unix)]
+fn read_pinned(path: &Path, limit: usize, expected: [u8; 32], secret: bool) -> io::Result<Vec<u8>> {
+    use std::os::unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt};
+
+    if !path.is_absolute() {
+        return Err(invalid_material());
+    }
+    let mut ancestor = PathBuf::from("/");
+    let mut components = path.components().peekable();
+    if components.next() != Some(Component::RootDir) {
+        return Err(invalid_material());
+    }
+    while let Some(component) = components.next() {
+        let Component::Normal(name) = component else {
+            return Err(invalid_material());
+        };
+        if components.peek().is_none() {
+            break;
+        }
+        ancestor.push(name);
+        let metadata = fs::symlink_metadata(&ancestor).map_err(|_| invalid_material())?;
+        if !metadata.file_type().is_dir()
+            || metadata.uid() != 0
+            || metadata.permissions().mode() & 0o022 != 0
+        {
+            return Err(invalid_material());
+        }
+    }
+    let path_metadata = fs::symlink_metadata(path).map_err(|_| invalid_material())?;
+    let mut options = OpenOptions::new();
+    options
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK);
+    let file = options.open(path).map_err(|_| invalid_material())?;
+    let metadata = file.metadata().map_err(|_| invalid_material())?;
+    let gid = rustix::process::getegid().as_raw();
+    for candidate in [&path_metadata, &metadata] {
+        if !candidate.file_type().is_file()
+            || candidate.len() > limit as u64
+            || candidate.uid() != 0
+            || candidate.gid() != gid
+            || candidate.permissions().mode() & 0o7777 != 0o440
+        {
+            return Err(invalid_material());
+        }
+    }
+    if path_metadata.dev() != metadata.dev() || path_metadata.ino() != metadata.ino() {
+        return Err(invalid_material());
+    }
+    let mut bytes = Vec::with_capacity(metadata.len() as usize);
+    let read_result = file.take(limit as u64 + 1).read_to_end(&mut bytes);
+    if read_result.is_err() || bytes.len() > limit || Sha256::digest(&bytes).as_slice() != expected
+    {
+        if secret {
+            bytes.zeroize();
+        }
+        return Err(invalid_material());
+    }
+    Ok(bytes)
+}
+
+#[cfg(not(unix))]
+fn read_pinned(
+    _path: &Path,
+    _limit: usize,
+    _expected: [u8; 32],
+    _secret: bool,
+) -> io::Result<Vec<u8>> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "managed client material requires Unix",
+    ))
+}
